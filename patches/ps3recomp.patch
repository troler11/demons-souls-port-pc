+        "    float2 st = i.uv * c0.xy;\n"
+        "    float3 m = tap(st);\n"
+        "    float nw = luma(tap(st + float2(-1, -1))), ne = luma(tap(st + float2(1, -1)));\n"
+        "    float sw = luma(tap(st + float2(-1, 1))), se = luma(tap(st + float2(1, 1))), lm = luma(m);\n"
+        "    float lmin = min(lm, min(min(nw, ne), min(sw, se)));\n"
+        "    float lmax = max(lm, max(max(nw, ne), max(sw, se)));\n"
+        "    float2 dir = float2(-((nw + ne) - (sw + se)), (nw + sw) - (ne + se));\n"
+        "    float red = max((nw + ne + sw + se) * (0.25 / 8.0), 1.0 / 128.0);\n"
+        "    dir = clamp(dir / (min(abs(dir.x), abs(dir.y)) + red), -8.0, 8.0);\n"
+        "    float3 a = 0.5 * (tap(st + dir * (1.0 / 3.0 - 0.5)) + tap(st + dir * (2.0 / 3.0 - 0.5)));\n"
+        "    float3 b = a * 0.5 + 0.25 * (tap(st - dir * 0.5) + tap(st + dir * 0.5));\n"
+        "    float lb = luma(b);\n"
+        "    return float4((lb < lmin || lb > lmax) ? a : b, 1); }\n"
+        /* FSR 1 EASU: 12-tap edge-adaptive Lanczos-like upscale (AMD FidelityFX, MIT) */
+        "void easu_set(inout float2 dir, inout float len, float w, float la, float lb, float lc, float ld_, float le) {\n"
+        "    float dx = ld_ - lb, lx = max(abs(ld_ - lc), abs(lc - lb));\n"
+        "    lx = saturate(abs(dx) / max(lx, 1e-5)); lx *= lx;\n"
+        "    float dy = le - la, ly = max(abs(le - lc), abs(lc - la));\n"
+        "    ly = saturate(abs(dy) / max(ly, 1e-5)); ly *= ly;\n"
+        "    dir += float2(dx, dy) * w; len += (lx + ly) * w; }\n"
+        "void easu_tap(inout float3 ac, inout float aw, float2 off, float2 dir, float2 len,\n"
+        "              float lob, float clp, float3 c) {\n"
+        "    float2 v = float2(off.x * dir.x + off.y * dir.y, off.x * (-dir.y) + off.y * dir.x) * len;\n"
+        "    float d2 = min(dot(v, v), clp);\n"
+        "    float wb = 2.0 / 5.0 * d2 - 1.0, wa = lob * d2 - 1.0;\n"
+        "    wb *= wb; wa *= wa;\n"
+        "    wb = 25.0 / 16.0 * wb - (25.0 / 16.0 - 1.0);\n"
+        "    float w = wb * wa; ac += c * w; aw += w; }\n"
+        "float el(float3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }\n"
+        "float4 ps_easu(V i) : SV_Target {\n"
+        "    float2 pp = i.uv * c0.xy - 0.5, fp = floor(pp); pp -= fp;\n"
+        "    int2 q = int2(fp);\n"
+        "    float3 b = ld(q + int2(0, -1)), c = ld(q + int2(1, -1));\n"
+        "    float3 e = ld(q + int2(-1, 0)), f = ld(q), g = ld(q + int2(1, 0)), h = ld(q + int2(2, 0));\n"
+        "    float3 ii = ld(q + int2(-1, 1)), j = ld(q + int2(0, 1)), k = ld(q + int2(1, 1)), l = ld(q + int2(2, 1));\n"
+        "    float3 n = ld(q + int2(0, 2)), o = ld(q + int2(1, 2));\n"
+        "    float bl = el(b), cl = el(c), elum = el(e), fl = el(f), gl = el(g), hl = el(h);\n"
+        "    float il = el(ii), jl = el(j), kl = el(k), ll = el(l), nl = el(n), ol = el(o);\n"
+        "    float2 dir = 0; float len = 0;\n"
+        "    easu_set(dir, len, (1.0 - pp.x) * (1.0 - pp.y), bl, elum, fl, gl, jl);\n"
+        "    easu_set(dir, len, pp.x * (1.0 - pp.y), cl, fl, gl, hl, kl);\n"
+        "    easu_set(dir, len, (1.0 - pp.x) * pp.y, fl, il, jl, kl, nl);\n"
+        "    easu_set(dir, len, pp.x * pp.y, gl, jl, kl, ll, ol);\n"
+        "    float dr = dot(dir, dir); bool zro = dr < 1.0 / 32768.0;\n"
+        "    dr = zro ? 1.0 : rsqrt(dr); dir.x = zro ? 1.0 : dir.x; dir *= dr;\n"
+        "    len = len * 0.5; len *= len;\n"
+        "    float stretch = dot(dir, dir) / max(abs(dir.x), abs(dir.y));\n"
+        "    float2 len2 = float2(1.0 + (stretch - 1.0) * len, 1.0 - 0.5 * len);\n"
+        "    float lob = 0.5 + ((1.0 / 4.0 - 0.04) - 0.5) * len, clp = 1.0 / lob;\n"
+        "    float3 mn = min(min(f, g), min(j, k)), mx = max(max(f, g), max(j, k));\n"
+        "    float3 ac = 0; float aw = 0;\n"
+        "    easu_tap(ac, aw, float2(0, -1) - pp, dir, len2, lob, clp, b);\n"
+        "    easu_tap(ac, aw, float2(1, -1) - pp, dir, len2, lob, clp, c);\n"
+        "    easu_tap(ac, aw, float2(-1, 1) - pp, dir, len2, lob, clp, ii);\n"
+        "    easu_tap(ac, aw, float2(0, 1) - pp, dir, len2, lob, clp, j);\n"
+        "    easu_tap(ac, aw, float2(0, 0) - pp, dir, len2, lob, clp, f);\n"
+        "    easu_tap(ac, aw, float2(-1, 0) - pp, dir, len2, lob, clp, e);\n"
+        "    easu_tap(ac, aw, float2(1, 1) - pp, dir, len2, lob, clp, k);\n"
+        "    easu_tap(ac, aw, float2(2, 1) - pp, dir, len2, lob, clp, l);\n"
+        "    easu_tap(ac, aw, float2(2, 0) - pp, dir, len2, lob, clp, h);\n"
+        "    easu_tap(ac, aw, float2(1, 0) - pp, dir, len2, lob, clp, g);\n"
+        "    easu_tap(ac, aw, float2(1, 2) - pp, dir, len2, lob, clp, o);\n"
+        "    easu_tap(ac, aw, float2(0, 2) - pp, dir, len2, lob, clp, n);\n"
+        "    return float4(min(mx, max(mn, ac / aw)), 1); }\n"
+        /* FSR 1 RCAS: robust contrast-adaptive sharpening */
+        "float4 ps_rcas(V i) : SV_Target {\n"
+        "    int2 p = int2(i.p.xy - c1.zw);\n"
+        "    float3 b = ld(p + int2(0, -1)), d = ld(p + int2(-1, 0)), e = ld(p);\n"
+        "    float3 f = ld(p + int2(1, 0)), h = ld(p + int2(0, 1));\n"
+        "    float3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));\n"
+        "    float3 hmin = min(mn4, e) / (4.0 * mx4 + 1e-5);\n"
+        "    float3 hmax = (1.0 - max(mx4, e)) / (4.0 * mn4 - 4.0 - 1e-5);\n"
+        "    float3 lr = max(-hmin, hmax);\n"
+        "    float lobe = max(-0.1875, min(max(lr.r, max(lr.g, lr.b)), 0.0)) * c2.x;\n"
+        "    return float4((lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0), 1); }\n";
+    static const char* const entry[POST_COUNT] = {"ps", "ps_fxaa", "ps_easu", "ps_rcas"};
+    ID3DBlob* vsb = NULL; ID3DBlob* psb[POST_COUNT] = {0}; ID3DBlob* err = NULL;
+    if (FAILED(D3DCompile(src, sizeof src - 1u, "ld_blit", NULL, NULL, "vs", "vs_5_0",
+                          D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vsb, &err))) {
+        fprintf(stderr, "[output] blit shader: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        return 0;
+    }
+    for (int i = 0; i < POST_COUNT; i++)
+        if (FAILED(D3DCompile(src, sizeof src - 1u, "ld_blit", NULL, NULL, entry[i], "ps_5_0",
+                              D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &psb[i], &err))) {
+            fprintf(stderr, "[output] blit shader %s: %s\n", entry[i],
+                    err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+            return 0;
+        }
+    D3D12_DESCRIPTOR_RANGE range = {0};
+    range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV; range.NumDescriptors = 1;
+    D3D12_ROOT_PARAMETER param[2] = {0};
+    param[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    param[0].DescriptorTable.NumDescriptorRanges = 1; param[0].DescriptorTable.pDescriptorRanges = &range;
+    param[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    param[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    param[1].Constants.Num32BitValues = 12;
+    param[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_STATIC_SAMPLER_DESC ss = {0};
+    ss.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    ss.AddressU = ss.AddressV = ss.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    ss.MaxLOD = D3D12_FLOAT32_MAX; ss.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+    rsd.NumParameters = 2; rsd.pParameters = param;
+    rsd.NumStaticSamplers = 1; rsd.pStaticSamplers = &ss;
+    ID3DBlob* sig = NULL;
+    if (FAILED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err)) ||
+        FAILED(g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                   sig->lpVtbl->GetBufferSize(sig), &IID_ID3D12RootSignature, (void**)&s_blit_rs)))
+        return 0;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = s_blit_rs;
+    pd.VS.pShaderBytecode = vsb->lpVtbl->GetBufferPointer(vsb); pd.VS.BytecodeLength = vsb->lpVtbl->GetBufferSize(vsb);
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM;
+    pd.SampleDesc.Count = 1;
+    for (int i = 0; i < POST_COUNT; i++) {
+        pd.PS.pShaderBytecode = psb[i]->lpVtbl->GetBufferPointer(psb[i]);
+        pd.PS.BytecodeLength = psb[i]->lpVtbl->GetBufferSize(psb[i]);
+        if (FAILED(g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState,
+                                                              (void**)&s_post_pso[i])))
+            return 0;
+    }
+    s_blit_pso = s_post_pso[POST_COPY];
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = LD_SWAP_BUFFERS + 2;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_blit_heap)))
+        return 0;
+    D3D12_DESCRIPTOR_HEAP_DESC rh = {0};
+    rh.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV; rh.NumDescriptors = 2;
+    if (FAILED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &rh, &IID_ID3D12DescriptorHeap, (void**)&s_post_rtv)))
+        return 0;
+    s_blit_failed = 0;
+    fprintf(stderr, "[output] %ux%u window, frames scaled from %ux%u; fxaa %d fsr %d sharpen %.2f\n",
+            ld_out_w(), ld_out_h(), g.width, g.height, ld_post_fxaa(), ld_post_fsr(), ld_post_sharp());
+    return 1;
+}
+
+/* Intermediate i, at least w x h, with its RTV and its SRV (blit heap slot
+ * LD_SWAP_BUFFERS + i); kept in PIXEL_SHADER_RESOURCE between passes. Grows
+ * only: a replaced one may still be in flight, so it is not released. */
+static ID3D12Resource* ld_post_tmp(int i, u32 w, u32 h)
+{
+    if (s_post_tmp[i] && s_post_tmp_w[i] >= w && s_post_tmp_h[i] >= h) return s_post_tmp[i];
+    if (s_post_tmp[i]) fprintf(stderr, "[output] post buffer %d grows to %ux%u\n", i, w, h);
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0}; rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = DXGI_FORMAT_R8G8B8A8_UNORM; rd.SampleDesc.Count = 1;
+    rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+    ID3D12Resource* r = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, NULL, &IID_ID3D12Resource, (void**)&r)))
+        return NULL;
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv, srv;
+    s_post_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_post_rtv, &rtv);
+    rtv.ptr += (size_t)i * g.rtv_step;
+    g.dev->lpVtbl->CreateRenderTargetView(g.dev, r, NULL, rtv);
+    s_blit_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_blit_heap, &srv);
+    srv.ptr += (size_t)(LD_SWAP_BUFFERS + i) * g.srv_step;
+    g.dev->lpVtbl->CreateShaderResourceView(g.dev, r, NULL, srv);
+    s_post_tmp[i] = r; s_post_tmp_w[i] = w; s_post_tmp_h[i] = h;
+    return r;
+}
+
+static void ld_post_barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    if (from == to) return;
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = from; b.Transition.StateAfter = to;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+}
+
+/* One full-screen pass: program pso reads SRV srv (a region rw x rh of a
+ * tw x th texture) and draws the rectangle (x, y, w, h) of rtv. */
+static void ld_post_pass(int pso, D3D12_CPU_DESCRIPTOR_HANDLE rtv, D3D12_GPU_DESCRIPTOR_HANDLE srv,
+                         float rw, float rh, float tw, float th,
+                         float x, float y, float w, float h, float sharp)
+{
+    const float c[12] = {rw, rh, 1.0f / tw, 1.0f / th, w, h, x, y, sharp, 0, 0, 0};
+    D3D12_VIEWPORT vp = {x, y, w, h, 0.0f, 1.0f};
+    D3D12_RECT sc = {(LONG)x, (LONG)y, (LONG)(x + w), (LONG)(y + h)};
+    g.list->lpVtbl->OMSetRenderTargets(g.list, 1, &rtv, FALSE, NULL);
+    g.list->lpVtbl->RSSetViewports(g.list, 1, &vp);
+    g.list->lpVtbl->RSSetScissorRects(g.list, 1, &sc);
+    g.list->lpVtbl->SetPipelineState(g.list, s_post_pso[pso]);
+    g.list->lpVtbl->SetGraphicsRootDescriptorTable(g.list, 0, srv);
+    g.list->lpVtbl->SetGraphicsRoot32BitConstants(g.list, 1, 12, c, 0);
+    g.list->lpVtbl->DrawInstanced(g.list, 3, 1, 0, 0);
+}
+
+/* Draw the region sw x sh (texels) of src (in state src_state) into back
+ * buffer bbi, scaled and letterboxed, through the post chain when post is
+ * set (the game's frames; movies only scale). Leaves the back buffer in
+ * PRESENT and src back in src_state. */
+static int ld_blit_to_backbuffer(ID3D12Resource* src, DXGI_FORMAT fmt, u32 sw, u32 sh,
+                                 D3D12_RESOURCE_STATES src_state, u32 bbi, int post)
+{
+    if (!ld_blit_init()) return 0;
+    ID3D12Resource* bb = g.backbuf[bbi];
+    ld_post_barrier(src, src_state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    ld_post_barrier(bb, D3D12_RESOURCE_STATE_PRESENT, D3D12_RESOURCE_STATE_RENDER_TARGET);
+
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu, trtv; D3D12_GPU_DESCRIPTOR_HANDLE gpu0, gpu;
+    s_blit_heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_blit_heap, &cpu);
+    s_blit_heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_blit_heap, &gpu0);
+    s_post_rtv->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_post_rtv, &trtv);
+    cpu.ptr += (size_t)bbi * g.srv_step; gpu = gpu0; gpu.ptr += (u64)bbi * g.srv_step;
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = fmt; sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; sv.Texture2D.MipLevels = 1;
+    g.dev->lpVtbl->CreateShaderResourceView(g.dev, src, &sv, cpu);
+    D3D12_RESOURCE_DESC sd; src->lpVtbl->GetDesc(src, &sd);
+
+    const D3D12_CPU_DESCRIPTOR_HANDLE rtv = rtv_handle(bbi);
+    const float black[4] = {0, 0, 0, 1};
+    g.list->lpVtbl->ClearRenderTargetView(g.list, rtv, black, 0, NULL);
+    ID3D12DescriptorHeap* heaps[] = {s_blit_heap};
+    g.list->lpVtbl->SetDescriptorHeaps(g.list, 1, heaps);
+    g.list->lpVtbl->SetGraphicsRootSignature(g.list, s_blit_rs);
+    g.list->lpVtbl->IASetPrimitiveTopology(g.list, D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    /* Keep the guest's aspect: the largest sw:sh rectangle that fits, on whole pixels. */
+    const u32 ow = ld_out_w(), oh = ld_out_h();
+    float vw = (float)ow, vh = floorf((float)ow * (float)sh / (float)sw + 0.5f);
+    if (vh > (float)oh) { vh = (float)oh; vw = floorf((float)oh * (float)sw / (float)sh + 0.5f); }
+    const float vx = floorf(((float)ow - vw) * 0.5f), vy = floorf(((float)oh - vh) * 0.5f);
+
+    /* cur: what the next pass reads */
+    float rw = (float)sw, rh = (float)sh, tw = (float)sd.Width, th = (float)sd.Height;
+    if (post && ld_post_fxaa() && ld_post_tmp(0, sw, sh)) {
+        D3D12_CPU_DESCRIPTOR_HANDLE r0 = trtv;
+        ld_post_barrier(s_post_tmp[0], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        ld_post_pass(POST_FXAA, r0, gpu, rw, rh, tw, th, 0, 0, rw, rh, 0);
+        ld_post_barrier(s_post_tmp[0], D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        gpu = gpu0; gpu.ptr += (u64)LD_SWAP_BUFFERS * g.srv_step;
+        tw = (float)s_post_tmp_w[0]; th = (float)s_post_tmp_h[0];
+    }
+    const int easu = post && ld_post_fsr() && (vw > rw || vh > rh);
+    const float sharp = post ? ld_post_sharp() : 0.0f;
+    if (sharp > 0.0f && ld_post_tmp(1, (u32)vw, (u32)vh)) {
+        D3D12_CPU_DESCRIPTOR_HANDLE r1 = trtv; r1.ptr += g.rtv_step;
+        ld_post_barrier(s_post_tmp[1], D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+        ld_post_pass(easu ? POST_EASU : POST_COPY, r1, gpu, rw, rh, tw, th, 0, 0, vw, vh, 0);
+        ld_post_barrier(s_post_tmp[1], D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        gpu = gpu0; gpu.ptr += (u64)(LD_SWAP_BUFFERS + 1) * g.srv_step;
+        ld_post_pass(POST_RCAS, rtv, gpu, vw, vh, (float)s_post_tmp_w[1], (float)s_post_tmp_h[1],
+                     vx, vy, vw, vh, sharp);
+    } else {
+        ld_post_pass(easu ? POST_EASU : POST_COPY, rtv, gpu, rw, rh, tw, th, vx, vy, vw, vh, 0);
+    }
+
+    ld_post_barrier(src, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, src_state);
+    ld_post_barrier(bb, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_PRESENT);
+    return 1;
+}
+
+/* ---------------------------------------------------------------------------
+ * LD_FRAMEGEN=1: frame generation. The game is CPU bound and the GPU mostly
+ * idle, so the GPU makes a frame halfway between each two the game presents:
+ * motion is estimated from the two images (block matching, 1/8 then 1/2
+ * resolution, median filtered; the game has no motion vectors to give) and
+ * both are warped halfway. A pixel that did not change (HUD, still scenery)
+ * keeps its own colour. The in-between frame is presented at once and the
+ * real one half a frame later, from rsx_live_draw_framegen_tick on the
+ * present thread's loop -- so nothing here blocks. Costs half a frame of
+ * latency; only useful on a display faster than the game's frame rate.
+ * -----------------------------------------------------------------------*/
+/* LD_FRAMEGEN=2 (for judging the generated frames): show only those -- the
+ * real frames are generated as usual but never presented. */
+static int ld_fg_mode(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("LD_FRAMEGEN"); v = e ? atoi(e) : 0; if (v < 0) v = 0; }
+    return v;
+}
+static int ld_fg_enabled(void) { return ld_fg_mode() != 0; }
+
+enum { FG_HALF, FG_EIGHTH, FG_COARSE, FG_REFINE, FG_MEDIAN, FG_NCS };
+/* descriptor slots in s_fg.heap */
+enum { FGS_HIST = 0, FGS_LH = 2, FGS_LHU = 4, FGS_LQ = 6, FGS_LQU = 8,
+       FGS_DC = 10, FGS_DCU = 11, FGS_DR = 12, FGS_DRU = 13, FGS_DM = 14, FGS_DMU = 15,
+       FGS_NULL = 16, FGS_COUNT = 17 };
+static struct {
+    int ok, failed;
+    ID3D12RootSignature* rs;
+    ID3D12PipelineState* cs[FG_NCS];
+    ID3D12PipelineState* interp;
+    ID3D12DescriptorHeap* heap;
+    ID3D12Resource* hist[2];          /* the last two real frames, output size */
+    ID3D12Resource* lh[2], *lq[2];    /* luma at 1/2 and 1/8 */
+    ID3D12Resource* dc, *dr, *dm;     /* motion grids: coarse, refined, median */
+    u32 w, h, hw, hh, qw, qh, gw, gh;
+    int cur, have_prev, pending;
+    LARGE_INTEGER due, last_real, qf;
+    double interval;                  /* real-frame interval, QPC ticks (smoothed) */
+    unsigned long long made;
+} s_fg;
+
+static const char s_fg_src[] =
+    "// Frame generation (LD_FRAMEGEN): a frame halfway between two presented ones.\n"
+    "// Motion is estimated from the images (the game gives no motion vectors):\n"
+    "// symmetric block matching, coarse at 1/8 resolution then refined at 1/2,\n"
+    "// median-filtered; the in-between frame warps both neighbours halfway.\n"
+    "Texture2D<float4> FA : register(t0);      // frames (prev, cur)\n"
+    "Texture2D<float4> FB : register(t1);\n"
+    "Texture2D<float>  LA : register(t2);      // luma pyramids (prev, cur)\n"
+    "Texture2D<float>  LB : register(t3);\n"
+    "Texture2D<float2> VC : register(t4);      // a motion grid\n"
+    "RWTexture2D<float>  U0 : register(u0);\n"
+    "RWTexture2D<float>  U1 : register(u1);\n"
+    "RWTexture2D<float2> UV : register(u2);\n"
+    "SamplerState smp : register(s0);\n"
+    "cbuffer K : register(b0) { int4 k0; float4 k1; };\n"
+    "// k0.xy: size of what this pass writes; k0.zw: size of what it reads\n"
+    "\n"
+    "float lum(float3 c) { return dot(c, float3(0.299, 0.587, 0.114)); }\n"
+    "\n"
+    "// full-res frames -> 1/2-res luma (U0 prev, U1 cur)\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void cs_half(uint3 id : SV_DispatchThreadID) {\n"
+    "    if ((int)id.x >= k0.x || (int)id.y >= k0.y) return;\n"
+    "    int2 p = int2(id.xy) * 2, m = k0.zw - 1;\n"
+    "    float a = 0, b = 0;\n"
+    "    [unroll] for (int y = 0; y < 2; y++)\n"
+    "    [unroll] for (int x = 0; x < 2; x++) {\n"
+    "        int3 q = int3(min(p + int2(x, y), m), 0);\n"
+    "        a += lum(FA.Load(q).rgb); b += lum(FB.Load(q).rgb);\n"
+    "    }\n"
+    "    U0[id.xy] = a * 0.25; U1[id.xy] = b * 0.25;\n"
+    "}\n"
+    "\n"
+    "// 1/2-res luma -> 1/8-res luma\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void cs_eighth(uint3 id : SV_DispatchThreadID) {\n"
+    "    if ((int)id.x >= k0.x || (int)id.y >= k0.y) return;\n"
+    "    int2 p = int2(id.xy) * 4, m = k0.zw - 1;\n"
+    "    float a = 0, b = 0;\n"
+    "    [unroll] for (int y = 0; y < 4; y++)\n"
+    "    [unroll] for (int x = 0; x < 4; x++) {\n"
+    "        int3 q = int3(min(p + int2(x, y), m), 0);\n"
+    "        a += LA.Load(q); b += LB.Load(q);\n"
+    "    }\n"
+    "    U0[id.xy] = a / 16.0; U1[id.xy] = b / 16.0;\n"
+    "}\n"
+    "\n"
+    "float sad(int2 c, int2 d, int half_, int step_, int2 m) {\n"
+    "    float s = 0;\n"
+    "    for (int y = -half_; y < half_; y += step_)\n"
+    "    for (int x = -half_; x < half_; x += step_) {\n"
+    "        int2 p = c + int2(x, y);\n"
+    "        s += abs(LA.Load(int3(clamp(p - d, 0, m), 0)) - LB.Load(int3(clamp(p + d, 0, m), 0)));\n"
+    "    }\n"
+    "    return s;\n"
+    "}\n"
+    "\n"
+    "// one cell = 32x32 full-res pixels = 4x4 at 1/8: d in [-8, 8] (1/8 px),\n"
+    "// the half-motion between the two frames, measured at the cell centre\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void cs_coarse(uint3 id : SV_DispatchThreadID) {\n"
+    "    if ((int)id.x >= k0.x || (int)id.y >= k0.y) return;\n"
+    "    int2 c = int2(id.xy) * 4 + 2, m = k0.zw - 1;\n"
+    "    float best = sad(c, int2(0, 0), 3, 1, m) * 0.9 - 1e-4;   // prefer no motion\n"
+    "    int2 bd = int2(0, 0);\n"
+    "    for (int y = -8; y <= 8; y++)\n"
+    "    for (int x = -8; x <= 8; x++) {\n"
+    "        float s = sad(c, int2(x, y), 3, 1, m);\n"
+    "        if (s < best) { best = s; bd = int2(x, y); }\n"
+    "    }\n"
+    "    UV[id.xy] = float2(bd);\n"
+    "}\n"
+    "\n"
+    "// refine at 1/2 res (cell = 16x16): around 4x the coarse answer, +-3\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void cs_refine(uint3 id : SV_DispatchThreadID) {\n"
+    "    if ((int)id.x >= k0.x || (int)id.y >= k0.y) return;\n"
+    "    int2 c = int2(id.xy) * 16 + 8, m = k0.zw - 1;\n"
+    "    int2 d0 = int2(VC.Load(int3(id.xy, 0)) * 4.0);\n"
+    "    float best = sad(c, int2(0, 0), 8, 2, m) * 0.9 - 1e-4;\n"
+    "    int2 bd = int2(0, 0);\n"
+    "    for (int y = -3; y <= 3; y++)\n"
+    "    for (int x = -3; x <= 3; x++) {\n"
+    "        float s = sad(c, d0 + int2(x, y), 8, 2, m);\n"
+    "        if (s < best) { best = s; bd = d0 + int2(x, y); }\n"
+    "    }\n"
+    "    UV[id.xy] = float2(bd);\n"
+    "}\n"
+    "\n"
+    "// 3x3 median per component\n"
+    "void srt(inout float a, inout float b) { float t = min(a, b); b = max(a, b); a = t; }\n"
+    "float med9(float v[9]) {\n"
+    "    // partial sorting network for the median of 9\n"
+    "    srt(v[1], v[2]); srt(v[4], v[5]); srt(v[7], v[8]);\n"
+    "    srt(v[0], v[1]); srt(v[3], v[4]); srt(v[6], v[7]);\n"
+    "    srt(v[1], v[2]); srt(v[4], v[5]); srt(v[7], v[8]);\n"
+    "    srt(v[0], v[3]); srt(v[5], v[8]); srt(v[4], v[7]);\n"
+    "    srt(v[3], v[6]); srt(v[1], v[4]); srt(v[2], v[5]);\n"
+    "    srt(v[4], v[7]); srt(v[4], v[2]); srt(v[6], v[4]);\n"
+    "    srt(v[4], v[2]);\n"
+    "    return v[4];\n"
+    "}\n"
+    "[numthreads(8, 8, 1)]\n"
+    "void cs_median(uint3 id : SV_DispatchThreadID) {\n"
+    "    if ((int)id.x >= k0.x || (int)id.y >= k0.y) return;\n"
+    "    float vx[9], vy[9]; int i = 0;\n"
+    "    [unroll] for (int y = -1; y <= 1; y++)\n"
+    "    [unroll] for (int x = -1; x <= 1; x++) {\n"
+    "        float2 v = VC.Load(int3(clamp(int2(id.xy) + int2(x, y), 0, k0.xy - 1), 0));\n"
+    "        vx[i] = v.x; vy[i] = v.y; i++;\n"
+    "    }\n"
+    "    UV[id.xy] = float2(med9(vx), med9(vy));\n"
+    "}\n"
+    "\n"
+    "// the in-between frame, full screen. k0.xy: frame size; k0.zw: grid size\n"
+    "struct V { float4 p : SV_Position; };\n"
+    "V vs(uint id : SV_VertexID) {\n"
+    "    V o; float2 t = float2((id << 1) & 2, id & 2);\n"
+    "    o.p = float4(t * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n"
+    "float4 ps_interp(V i) : SV_Target {\n"
+    "    float2 sz = float2(k0.xy), p = i.p.xy;\n"
+    "    // half-motion in full-res pixels (the grid holds 1/2-res pixels)\n"
+    "    float2 d = VC.SampleLevel(smp, p / (32.0 * float2(k0.zw)), 0) * 2.0;\n"
+    "    float3 a = FA.SampleLevel(smp, (p - d) / sz, 0).rgb;\n"
+    "    float3 b = FB.SampleLevel(smp, (p + d) / sz, 0).rgb;\n"
+    "    float3 s0 = FA.Load(int3(p, 0)).rgb, s1 = FB.Load(int3(p, 0)).rgb;\n"
+    "    float e1 = dot(abs(a - b), 1.0), e0 = dot(abs(s0 - s1), 1.0);\n"
+    "    // a pixel that did not change (HUD, still scenery) keeps its own colour\n"
+    "    float3 c = (e0 <= e1 + 0.02) ? 0.5 * (s0 + s1) : 0.5 * (a + b);\n"
+    "    return float4(c, 1);\n"
+    "}\n"
+;
+
+static UINT ld_present_interval(void);
+
+static ID3D12Resource* fg_tex(u32 w, u32 h, DXGI_FORMAT f, int uav, D3D12_RESOURCE_STATES st)
+{
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC rd = {0}; rd.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    rd.Width = w; rd.Height = h; rd.DepthOrArraySize = 1; rd.MipLevels = 1;
+    rd.Format = f; rd.SampleDesc.Count = 1;
+    if (uav) rd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    ID3D12Resource* r = NULL;
+    if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &rd, st, NULL,
+                                                      &IID_ID3D12Resource, (void**)&r)))
+        return NULL;
+    return r;
+}
+static D3D12_CPU_DESCRIPTOR_HANDLE fg_cpu(int slot)
+{
+    D3D12_CPU_DESCRIPTOR_HANDLE h; s_fg.heap->lpVtbl->GetCPUDescriptorHandleForHeapStart(s_fg.heap, &h);
+    h.ptr += (size_t)slot * g.srv_step; return h;
+}
+static D3D12_GPU_DESCRIPTOR_HANDLE fg_gpu(int slot)
+{
+    D3D12_GPU_DESCRIPTOR_HANDLE h; s_fg.heap->lpVtbl->GetGPUDescriptorHandleForHeapStart(s_fg.heap, &h);
+    h.ptr += (u64)slot * g.srv_step; return h;
+}
+static void fg_srv(ID3D12Resource* r, DXGI_FORMAT f, int slot)
+{
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv = {0};
+    sv.Format = f; sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING; sv.Texture2D.MipLevels = 1;
+    g.dev->lpVtbl->CreateShaderResourceView(g.dev, r, &sv, fg_cpu(slot));
+}
+static void fg_uav(ID3D12Resource* r, DXGI_FORMAT f, int slot)
+{
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uv = {0};
+    uv.Format = f; uv.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+    g.dev->lpVtbl->CreateUnorderedAccessView(g.dev, r, NULL, &uv, fg_cpu(slot));
+}
+
+static int fg_init(void)
+{
+    if (s_fg.ok) return 1;
+    if (s_fg.failed) return 0;
+    s_fg.failed = 1;
+    static const char* const cs_entry[FG_NCS] = {"cs_half", "cs_eighth", "cs_coarse", "cs_refine", "cs_median"};
+    ID3DBlob* blob = NULL; ID3DBlob* err = NULL;
+    /* root: t0..t4 (one table each), u0..u2 (one table each), 8 constants */
+    D3D12_DESCRIPTOR_RANGE rg[8] = {0};
+    D3D12_ROOT_PARAMETER rp[9] = {0};
+    for (int i = 0; i < 8; i++) {
+        rg[i].RangeType = i < 5 ? D3D12_DESCRIPTOR_RANGE_TYPE_SRV : D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+        rg[i].NumDescriptors = 1; rg[i].BaseShaderRegister = i < 5 ? (UINT)i : (UINT)(i - 5);
+        rp[i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        rp[i].DescriptorTable.NumDescriptorRanges = 1; rp[i].DescriptorTable.pDescriptorRanges = &rg[i];
+        rp[i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    }
+    rp[8].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[8].Constants.Num32BitValues = 8; rp[8].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_STATIC_SAMPLER_DESC ss = {0};
+    ss.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    ss.AddressU = ss.AddressV = ss.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    ss.MaxLOD = D3D12_FLOAT32_MAX; ss.ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rsd = {0};
+    rsd.NumParameters = 9; rsd.pParameters = rp; rsd.NumStaticSamplers = 1; rsd.pStaticSamplers = &ss;
+    if (FAILED(D3D12SerializeRootSignature(&rsd, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &err)) ||
+        FAILED(g.dev->lpVtbl->CreateRootSignature(g.dev, 0, blob->lpVtbl->GetBufferPointer(blob),
+                   blob->lpVtbl->GetBufferSize(blob), &IID_ID3D12RootSignature, (void**)&s_fg.rs))) {
+        fprintf(stderr, "[framegen] root signature failed\n");
+        return 0;
+    }
+    for (int i = 0; i < FG_NCS; i++) {
+        ID3DBlob* cs = NULL;
+        if (FAILED(D3DCompile(s_fg_src, sizeof s_fg_src - 1u, "framegen", NULL, NULL, cs_entry[i], "cs_5_0",
+                              D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &cs, &err))) {
+            fprintf(stderr, "[framegen] %s: %s\n", cs_entry[i],
+                    err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+            return 0;
+        }
+        D3D12_COMPUTE_PIPELINE_STATE_DESC cd = {0};
+        cd.pRootSignature = s_fg.rs;
+        cd.CS.pShaderBytecode = cs->lpVtbl->GetBufferPointer(cs); cd.CS.BytecodeLength = cs->lpVtbl->GetBufferSize(cs);
+        if (FAILED(g.dev->lpVtbl->CreateComputePipelineState(g.dev, &cd, &IID_ID3D12PipelineState, (void**)&s_fg.cs[i])))
+            return 0;
+    }
+    ID3DBlob* vsb = NULL; ID3DBlob* psb = NULL;
+    if (FAILED(D3DCompile(s_fg_src, sizeof s_fg_src - 1u, "framegen", NULL, NULL, "vs", "vs_5_0",
+                          D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vsb, &err)) ||
+        FAILED(D3DCompile(s_fg_src, sizeof s_fg_src - 1u, "framegen", NULL, NULL, "ps_interp", "ps_5_0",
+                          D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &psb, &err))) {
+        fprintf(stderr, "[framegen] interp: %s\n", err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        return 0;
+    }
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = s_fg.rs;
+    pd.VS.pShaderBytecode = vsb->lpVtbl->GetBufferPointer(vsb); pd.VS.BytecodeLength = vsb->lpVtbl->GetBufferSize(vsb);
+    pd.PS.pShaderBytecode = psb->lpVtbl->GetBufferPointer(psb); pd.PS.BytecodeLength = psb->lpVtbl->GetBufferSize(psb);
+    pd.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    pd.SampleMask = 0xFFFFFFFFu;
+    pd.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID; pd.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    pd.RasterizerState.DepthClipEnable = TRUE;
+    pd.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    pd.NumRenderTargets = 1; pd.RTVFormats[0] = DXGI_FORMAT_R8G8B8A8_UNORM; pd.SampleDesc.Count = 1;
+    if (FAILED(g.dev->lpVtbl->CreateGraphicsPipelineState(g.dev, &pd, &IID_ID3D12PipelineState, (void**)&s_fg.interp)))
+        return 0;
+
+    D3D12_DESCRIPTOR_HEAP_DESC hd = {0};
+    hd.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV; hd.NumDescriptors = FGS_COUNT;
+    hd.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    if (FAILED(g.dev->lpVtbl->CreateDescriptorHeap(g.dev, &hd, &IID_ID3D12DescriptorHeap, (void**)&s_fg.heap)))
+        return 0;
+    s_fg.w = ld_out_w(); s_fg.h = ld_out_h();
+    s_fg.hw = (s_fg.w + 1) / 2; s_fg.hh = (s_fg.h + 1) / 2;
+    s_fg.qw = (s_fg.hw + 3) / 4; s_fg.qh = (s_fg.hh + 3) / 4;
+    s_fg.gw = (s_fg.w + 31) / 32; s_fg.gh = (s_fg.h + 31) / 32;
+    const D3D12_RESOURCE_STATES SR = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+    for (int i = 0; i < 2; i++) {
+        if (!(s_fg.hist[i] = fg_tex(s_fg.w, s_fg.h, DXGI_FORMAT_R8G8B8A8_UNORM, 0, SR)) ||
+            !(s_fg.lh[i] = fg_tex(s_fg.hw, s_fg.hh, DXGI_FORMAT_R16_FLOAT, 1, SR)) ||
+            !(s_fg.lq[i] = fg_tex(s_fg.qw, s_fg.qh, DXGI_FORMAT_R16_FLOAT, 1, SR)))
+            return 0;
+        fg_srv(s_fg.hist[i], DXGI_FORMAT_R8G8B8A8_UNORM, FGS_HIST + i);
+        fg_srv(s_fg.lh[i], DXGI_FORMAT_R16_FLOAT, FGS_LH + i); fg_uav(s_fg.lh[i], DXGI_FORMAT_R16_FLOAT, FGS_LHU + i);
+        fg_srv(s_fg.lq[i], DXGI_FORMAT_R16_FLOAT, FGS_LQ + i); fg_uav(s_fg.lq[i], DXGI_FORMAT_R16_FLOAT, FGS_LQU + i);
+    }
+    if (!(s_fg.dc = fg_tex(s_fg.gw, s_fg.gh, DXGI_FORMAT_R16G16_FLOAT, 1, SR)) ||
+        !(s_fg.dr = fg_tex(s_fg.gw, s_fg.gh, DXGI_FORMAT_R16G16_FLOAT, 1, SR)) ||
+        !(s_fg.dm = fg_tex(s_fg.gw, s_fg.gh, DXGI_FORMAT_R16G16_FLOAT, 1, SR)))
+        return 0;
+    fg_srv(s_fg.dc, DXGI_FORMAT_R16G16_FLOAT, FGS_DC); fg_uav(s_fg.dc, DXGI_FORMAT_R16G16_FLOAT, FGS_DCU);
+    fg_srv(s_fg.dr, DXGI_FORMAT_R16G16_FLOAT, FGS_DR); fg_uav(s_fg.dr, DXGI_FORMAT_R16G16_FLOAT, FGS_DRU);
+    fg_srv(s_fg.dm, DXGI_FORMAT_R16G16_FLOAT, FGS_DM); fg_uav(s_fg.dm, DXGI_FORMAT_R16G16_FLOAT, FGS_DMU);
+    /* a null SRV for tables a pass leaves unused */
+    fg_srv(NULL, DXGI_FORMAT_R8G8B8A8_UNORM, FGS_NULL);
+    QueryPerformanceFrequency(&s_fg.qf);
+    s_fg.ok = 1; s_fg.failed = 0;
+    fprintf(stderr, "[framegen] on: %ux%u, motion grid %ux%u\n", s_fg.w, s_fg.h, s_fg.gw, s_fg.gh);
+    return 1;
+}
+
+static void fg_barrier(ID3D12Resource* r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+{
+    D3D12_RESOURCE_BARRIER b = {0};
+    b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION; b.Transition.pResource = r;
+    b.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    b.Transition.StateBefore = from; b.Transition.StateAfter = to;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+}
+#define FG_SR (D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE)
+
+/* Bind t0..t4 / u0..u2 (slot or -1 = null/none) and constants, dispatch. */
+static void fg_dispatch(int pso, const int t[5], const int u[3], int ow, int oh, int iw, int ih, u32 gx, u32 gy)
+{
+    ID3D12GraphicsCommandList* L = g.list;
+    L->lpVtbl->SetPipelineState(L, s_fg.cs[pso]);
+    for (int i = 0; i < 5; i++) L->lpVtbl->SetComputeRootDescriptorTable(L, (UINT)i, fg_gpu(t[i] >= 0 ? t[i] : FGS_NULL));
+    for (int i = 0; i < 3; i++) if (u[i] >= 0) L->lpVtbl->SetComputeRootDescriptorTable(L, (UINT)(5 + i), fg_gpu(u[i]));
+    const int k[8] = {ow, oh, iw, ih, 0, 0, 0, 0};
+    L->lpVtbl->SetComputeRoot32BitConstants(L, 8, 8, k, 0);
+    L->lpVtbl->Dispatch(L, gx, gy, 1);
+}
+static void fg_uav_barrier(void)
+{
+    D3D12_RESOURCE_BARRIER b = {0}; b.Type = D3D12_RESOURCE_BARRIER_TYPE_UAV;
+    g.list->lpVtbl->ResourceBarrier(g.list, 1, &b);
+}
+
+/* bb (in PRESENT) holds the new real frame. Keep it; if there is a previous
