+/* RECV_TRACE_TID=<guest tid> [RECV_TRACE_FROM_S=<s>, RECV_TRACE_N=<n>]: each
+ * sys_event_queue_receive of that thread -- queue, timeout, how long it
+ * waited, the event's data words, and the time -- to lay out what paces a
+ * loop (Demon's Souls' audio mixer). */
+/* HANG_WATCH_LINE=<hex ea> / HANG_WATCH_Q=<queue id>: a ring of protocol
+ * events on one 128-byte line (SPU GETLLAR/PUTLLC/PUTLLUC, PPU stwcx) and one
+ * event queue (push, push refused because full, receive enter/leave), printed
+ * by the hang dump below. Writing each to stderr instead slowed the game to
+ * ~5 fps and the race no longer happened. */
+typedef struct { unsigned long long t; uint32_t a, b, c, d; char k; } hang_ev;
+static hang_ev s_hev[4096];
+static volatile long s_hev_n;
+static int s_hw_init;
+static uint32_t s_hw_line, s_hw_q;
+static void hang_watch_init(void)
+{
+    const char* e = getenv("HANG_WATCH_LINE");
+    s_hw_line = e ? (uint32_t)strtoul(e, NULL, 16) & ~127u : 0;
+    e = getenv("HANG_WATCH_Q");
+    s_hw_q = e ? (uint32_t)atoi(e) : 0;
+    s_hw_init = 1;
+}
+uint32_t hang_watch_line(void) { if (!s_hw_init) hang_watch_init(); return s_hw_line; }
+uint32_t hang_watch_queue(void) { if (!s_hw_init) hang_watch_init(); return s_hw_q; }
+void hang_trace(char k, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+    extern unsigned long long ps3_qpc_us(void);
+    const long i = _InterlockedIncrement(&s_hev_n) - 1;
+    hang_ev* e = &s_hev[i & 4095];
+    e->t = ps3_qpc_us(); e->a = a; e->b = b; e->c = c; e->d = d; e->k = k;
+}
+static void hang_trace_dump(void)
+{
+    const long n = s_hev_n;
+    if (!n) return;
+    const long first = n > 160 ? n - 160 : 0;
+    fprintf(stderr, "[hang] protocol ring (line %08X queue %u): last %ld of %ld events\n",
+            s_hw_line, s_hw_q, n - first, n);
+    const unsigned long long t_end = s_hev[(n - 1) & 4095].t;
+    for (long i = first; i < n; i++) {
+        const hang_ev* e = &s_hev[i & 4095];
+        const char* what =
+            e->k == 'G' ? "SPU GETLLAR   spu=%X  w0=%08X w1=%08X" :
+            e->k == 'P' ? "SPU PUTLLC %s spu=%X  w0=%08X w1=%08X" :
+            e->k == 'U' ? "SPU PUTLLUC   spu=%X  w0=%08X w1=%08X" :
+            e->k == 'C' ? "PPU stwcx  %s tid=%u expected=%08X new=%08X" :
+            e->k == 'E' ? "evq push   pending_before=%u d1=%08X d2=%08X d3=%08X" :
+            e->k == 'F' ? "evq push REFUSED (full) cap=%u d1=%08X d2=%08X d3=%08X" :
+            e->k == 'R' ? "receive enter tid=%u" :
+            e->k == 'r' ? "receive leave tid=%u rc=%d d1=%08X d2=%08X" : "?";
+        char line[256];
+        if (e->k == 'P') snprintf(line, sizeof line, what, e->d ? "FAIL" : "ok  ", e->a, e->b, e->c);
+        else if (e->k == 'C') snprintf(line, sizeof line, what, e->d ? "ok  " : "FAIL", e->a, e->b, e->c);
+        else snprintf(line, sizeof line, what, e->a, e->b, e->c, e->d);
+        fprintf(stderr, "[hang]  %+10.3f ms  %s\n", -(double)(t_end - e->t) / 1000.0, line);
+    }
+}
+
+/* Who waits on which queue, for PS3_HANG_DUMP (ppu_loader.cpp): a slot per
+ * guest thread, filled for the duration of every receive. When the game
+ * freezes in one, the dump shows the queue, the waiter's registers and the
+ * guest memory those registers point at -- e.g. the CellSpursQueue a
+ * cellSpursQueuePopBody is blocked on, which tells an empty queue from a
+ * wake-up that was lost. */
+typedef struct { ppu_context* ctx; uint32_t q; unsigned long long since_us; } evq_waiter;
+static evq_waiter s_evq_wait[256];
+void evq_hang_report(void)
+{
+    extern unsigned long long ps3_qpc_us(void);
+    extern uint8_t* vm_base;
+    const unsigned long long now = ps3_qpc_us();
+    for (int i = 0; i < 256; i++) {
+        ppu_context* c = s_evq_wait[i].ctx;
+        if (!c) continue;
+        const uint32_t wq = s_evq_wait[i].q;
+        const sys_event_queue_info* qi = wq && wq <= SYS_EVENT_QUEUE_MAX ? &g_sys_event_queues[wq - 1] : NULL;
+        fprintf(stderr, "[hang] evq waiter guest_tid=%llu queue=%u (pending %u of %u) for %.1f s lr=0x%08X\n",
+                (unsigned long long)c->thread_id, wq, qi ? (unsigned)qi->count : 0u, qi ? (unsigned)qi->capacity : 0u,
+                (double)(now - s_evq_wait[i].since_us) / 1e6, (uint32_t)c->lr);
+        char line[512]; int n = 0;
+        for (int r = 3; r < 32; r++) {
+            n += snprintf(line + n, sizeof line - n, " r%d=%08X", r, (uint32_t)c->gpr[r]);
+            if (r == 17 || r == 31) { fprintf(stderr, "[hang]  %s\n", line); n = 0; }
+        }
+        for (int r = 3; r < 32; r++) {
+            const uint32_t p = (uint32_t)c->gpr[r];
+            if (p < 0x10000u || p >= 0x50000000u || (p & 3u)) continue;
+            int dup = 0;
+            for (int k = 3; k < r; k++) if ((uint32_t)c->gpr[k] == p) dup = 1;
+            if (dup) continue;
+            n = snprintf(line, sizeof line, "[hang]  mem r%d @%08X:", r, p);
+            for (int w = 0; w < 16; w++) {
+                const uint8_t* m = vm_base + p + w * 4;
+                n += snprintf(line + n, sizeof line - n, " %02X%02X%02X%02X", m[0], m[1], m[2], m[3]);
+            }
+            fprintf(stderr, "%s\n", line);
+        }
+    }
+    hang_trace_dump();
+    fflush(stderr);
+}
+
+int64_t sys_event_queue_receive(ppu_context* ctx)
+{
+    extern unsigned long long ps3_qpc_us(void);
+    evq_waiter* slot = &s_evq_wait[ctx->thread_id & 255];
+    slot->q = LV2_ARG_U32(ctx, 0); slot->since_us = 0; slot->since_us = ps3_qpc_us(); slot->ctx = ctx;
+    const int traced = slot->q && slot->q == hang_watch_queue();
+    if (traced) hang_trace('R', (uint32_t)ctx->thread_id, 0, 0, 0);
+    const int64_t rc = sys_event_queue_receive_traced(ctx);
+    if (traced) hang_trace('r', (uint32_t)ctx->thread_id, (uint32_t)rc, (uint32_t)ctx->gpr[5], (uint32_t)ctx->gpr[6]);
+    slot->ctx = NULL;
+    return rc;
+}
+
+static int64_t sys_event_queue_receive_traced(ppu_context* ctx)
+{
+    static long tid = -2; static double from_s; static long left;
+    if (tid == -2) { const char* e = getenv("RECV_TRACE_TID"); tid = e ? atol(e) : -1;
+                     e = getenv("RECV_TRACE_FROM_S"); from_s = e ? atof(e) : 0;
+                     e = getenv("RECV_TRACE_N"); left = e ? atol(e) : 400; }
+    if (tid < 0 || (long)ctx->thread_id != tid || left <= 0) return sys_event_queue_receive_impl(ctx);
+    extern unsigned long long ps3_qpc_us(void);
+    static unsigned long long t0;
+    const unsigned long long a = ps3_qpc_us();
+    if (!t0) t0 = a;
+    const uint32_t q = LV2_ARG_U32(ctx, 0);
+    const uint64_t to = LV2_ARG_U64(ctx, 2);
+    const int64_t r = sys_event_queue_receive_impl(ctx);
+    const unsigned long long b = ps3_qpc_us();
+    if ((double)(a - t0) / 1e6 >= from_s) {
+        left--;
+        fprintf(stderr, "[recv] t=%.3fms q=%u timeout=%llu waited=%lluus rc=%d d1=0x%llX d2=0x%llX d3=0x%llX\n",
+                (double)a / 1000.0, q, (unsigned long long)to, b - a, (int)r,
+                (unsigned long long)ctx->gpr[5], (unsigned long long)ctx->gpr[6], (unsigned long long)ctx->gpr[7]);
+    }
+    return r;
+}
