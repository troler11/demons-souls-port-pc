+/* get_pso: is this PSO key waiting on a compile? Forgets it once both are done. */
+static int ld_ash_key_pending(u64 key)
+{
+    for (u32 i = 0; i < s_ash.n_pending; i++) {
+        if (s_ash.pending[i].key != key) continue;
+        if (ld_ash_busy(s_ash.pending[i].wait.vs) || ld_ash_busy(s_ash.pending[i].wait.ps))
+            return 1;
+        s_ash.pending[i] = s_ash.pending[--s_ash.n_pending];
+        return 0;
+    }
+    return 0;
+}
+
+static int ld_ash_key_wait(u64 key, const ld_ash_wait* wait)
+{
+    if (s_ash.n_pending >= LD_ASH_PENDING) return 0;
+    s_ash.pending[s_ash.n_pending].key = key;
+    s_ash.pending[s_ash.n_pending].wait = *wait;
+    s_ash.n_pending++;
+    { static u32 said;
+      if ((s_ash.done + s_ash.failed) / 32u != said) {
+          said = (u32)(s_ash.done + s_ash.failed) / 32u;
+          fprintf(stderr, "[async-shaders] compiled %ld (failed %ld), %u queued so far\n",
+                  (long)s_ash.done, (long)s_ash.failed, s_ash.n_jobs);
+      } }
+    return 1;
+}
