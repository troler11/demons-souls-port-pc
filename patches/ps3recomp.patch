+        const __m128i z = _mm_xor_si128(spu__xs_ld(c), _mm_set1_epi32((int)negc));
+        const __m128i ex = spu__xs_bexp(x), ey = spu__xs_bexp(y), lim = _mm_set1_epi32(253);
+        const __m128i big = _mm_or_si128(_mm_or_si128(_mm_cmpgt_epi32(ex, lim), _mm_cmpgt_epi32(ey, lim)),
+                                         _mm_or_si128(_mm_cmpgt_epi32(spu__xs_bexp(z), lim),
+                                                      _mm_cmpgt_epi32(_mm_add_epi32(ex, ey), _mm_set1_epi32(379))));
+        const __m128i r = _mm_castps_si128(spu__xs_pos0f(_mm_fmadd_ps(_mm_castsi128_ps(x), _mm_castsi128_ps(y),
