+        return;
+    }
+    double w = 0, t0 = ld_prof_ms();
+    ld_flush_impl(reason, &w);
+    const double elapsed = ld_prof_ms() - t0;
+    ps3_perf_trace_end("flush", perf_begin, g_ld_frames, (unsigned)reason);
+    if (prof && (unsigned)reason < LD_FLUSH_REASON_COUNT) {
+        g_fp_n[reason]++; g_fp_ms[reason] += elapsed; g_fp_wait_ms[reason] += w;
+        g_fp_cum_flush_ms += elapsed;
+    }
+    if (hitch && elapsed >= 1.0)
