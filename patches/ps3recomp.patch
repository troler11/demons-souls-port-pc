+/* ===========================================================================
+ * Channel write
+ * ===========================================================================*/
+/* spu_helpers.h's inline MFC parameter writes: 1 once spu_wrch has seen that no
+ * channel diagnostic is armed (the inline path would hide writes from it). */
+int g_spu_wrch_fast = 0;
+int g_spu_rdch_fast = 0;
+
+int g_spu_dma_diag = -1;
+int spu_dma_diag_init(void)
+{
+    static const char* const vars[] = {
+        "SPU_DMA_WATCH", "SPU_DMA_RANGE", "SPU_DMACHK", "SPU_GETHIST", "SPU_PUTHIST",
+        "SPU_MFC_TRACE", "SPU_DUMP_GET", "SPU_DSP_IMAGE_EA", "LBP_SKIP_NULL_DMA",
+        "SPU_OVL_DIAG", "SPU_GET_DUMP_LSA", "SPU_STACKEA_WATCH", "SPU_SMC_WATCH",
+        "SPU_LOCKGUARD", "SPU_POISON_DMA", "SPU_CMDHIST", "SPU_WATCHEA",
+        "SPU_WATCHLSA", "SPU_ROWCOV", "SPU_VRAMPC", "SPU_H2LSRC", "SPU_PUTEA",
+        "SPU_DMATRACE_ALL", "SPU_DMATRACE", "SPU_DMATRACE_RAW", "SPU_CMDDUMP",
+        "SPU_POLLTRACE", "SPU_ATOMTRACE", "SPU_ATOM_EA", "SPU_LLARWATCH", "SPU_PUTLLC_WHY",
+        NULL
+    };
+    int diag = 0;
+    for (int i = 0; vars[i]; i++) {
+        const char* e = getenv(vars[i]);
+        if (e && *e && *e != '0') { diag = 1; break; }
