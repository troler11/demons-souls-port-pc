+/* ---------------------------------------------------------------------------
+ * Sony pads over HID: DualShock 4 (USB and Bluetooth) and DualSense, read
+ * directly -- no DS4Windows/Steam needed. Windows exposes them as plain HID
+ * devices, not XInput. One reader thread per pad keeps the last report; the
+ * poll just copies it. Hot-plug: rescanned every 2 s. PAD_NO_HID=1: off.
+ * Pads found here take the host ports XInput left empty.
+ * -----------------------------------------------------------------------*/
+#include <setupapi.h>
+#include <hidsdi.h>
+#pragma comment(lib, "setupapi.lib")
+#pragma comment(lib, "hid.lib")
+
+#define DS_MAX 4
+typedef struct {
+    volatile LONG live;           /* reader running */
+    HANDLE h;
+    char path[512];
+    int dualsense;
+    SRWLOCK lock;
+    PadHostState st;              /* latest state, under lock */
+} DsPad;
+static DsPad s_ds[DS_MAX];
+static volatile LONG s_ds_started;
+
+volatile unsigned g_pad0_reads = 0;
+volatile unsigned g_pad0_empty_reads = 0;
+volatile unsigned g_pad0_buttons = 0;
+volatile unsigned g_pad0_lstick = 0;
+unsigned (*g_pad_title_hook)(void) = NULL;
+static volatile long s_host_hold = 0;
+
+void cellPad_set_host_hold(int hold)
+{
+    s_host_hold = hold ? 1 : 0;
+}
+
+typedef struct {
+    unsigned short buttons;
+    unsigned char lx, ly, rx, ry;
+    unsigned char l2, r2;
+} PadHidSonyState;
+
+static void ds_start(void);
+
+int pad_hid_sony_poll(PadHidSonyState* out, int max)
+{
+    ds_start();
+    if (getenv("PAD_NO_HID")) return 0;
+    int n = 0;
+    for (int k = 0; k < DS_MAX && n < max; k++) {
+        AcquireSRWLockShared(&s_ds[k].lock);
+        PadHostState st = s_ds[k].st;
+        ReleaseSRWLockShared(&s_ds[k].lock);
+        if (!st.connected) continue;
+        out[n].buttons = st.buttons;
+        out[n].lx = st.analog_lx;
+        out[n].ly = st.analog_ly;
+        out[n].rx = st.analog_rx;
+        out[n].ry = st.analog_ry;
+        out[n].l2 = st.trigger_l2;
+        out[n].r2 = st.trigger_r2;
+        n++;
+    }
+    return n;
+}
