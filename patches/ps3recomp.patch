+/* ---------------------------------------------------------------------------
+ * One renderer, two threads. The FIFO walker drives everything above; a host
+ * movie (sail_host_movie.c) presents its frames from its own thread, through
+ * the same command list, upload ring and swap chain. Unserialized, the two
+ * corrupted the list (Close E_FAIL) or the device (Present DEVICE_REMOVED)
+ * during Demon's Souls' opening movie, and the screen stayed black after it.
+ * Every entry point takes this one recursive lock; uncontended it costs a few
+ * tens of nanoseconds.
+ * -----------------------------------------------------------------------*/
+static CRITICAL_SECTION s_ld_entry_lock;
+static INIT_ONCE s_ld_entry_once = INIT_ONCE_STATIC_INIT;
+#include "rsx_fifo_worker.h"
+static BOOL CALLBACK ld_entry_init(PINIT_ONCE o, PVOID p, PVOID* c)
+{ (void)o; (void)p; (void)c; InitializeCriticalSection(&s_ld_entry_lock); return TRUE; }
+static void ld_lock(void)
+{
+    ld_fifo_enter(); ld_fifo_drain();
+    InitOnceExecuteOnce(&s_ld_entry_once, ld_entry_init, NULL, NULL);
+    EnterCriticalSection(&s_ld_entry_lock);
+}
+static void ld_unlock(void)
+{ LeaveCriticalSection(&s_ld_entry_lock); ld_fifo_leave(); }
+static void ld_fifo_execute(const ld_fifo_word* words, u32 count)
+{
+    ld_lock();
+    for (u32 i = 0; i < count; i++)
+        rsx_live_draw_method_unlocked(words[i].method, words[i].arg);
+    ld_unlock();
+}
+static void ld_fifo_direct(u32 method, u32 step, const u32* args, u32 count)
+{
+    ld_lock();
+    for (u32 i = 0; i < count; i++)
+        rsx_live_draw_method_unlocked(method + i * step, args[i]);
+    ld_unlock();
+}
+void rsx_live_draw_fifo_packet(u32 method, u32 step, const u32* args, u32 count)
+{ if (args && count <= 2047u) ld_fifo_packet(method, step, args, count); }
+void rsx_live_draw_fifo_sync(void)
+{ ld_fifo_enter(); ld_fifo_drain(); ld_fifo_leave(); }
+void rsx_live_draw_fifo_stop(void) { ld_fifo_shutdown(); }
+
+void rsx_live_draw_method(u32 method, u32 arg)
+{ ld_lock(); rsx_live_draw_method_unlocked(method, arg); ld_unlock(); }
