+static int ld_async_shaders_on(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("LD_ASYNC_SHADERS");
+        v = !(e && *e == '0') && shader_disk_cache_prepare();
+        if (v) {
+            InitializeSRWLock(&s_ash.lock);
+            InitializeConditionVariable(&s_ash.cv);
+            DWORD_PTR pm = 0, sm = 0; int cpus = 0;
+            if (GetProcessAffinityMask(GetCurrentProcess(), &pm, &sm))
+                for (; pm; pm &= pm - 1) cpus++;
+            const int workers = cpus >= 12 ? 3 : cpus >= 6 ? 2 : 1;
+            for (int i = 0; i < workers; i++) {
+                HANDLE t = CreateThread(NULL, 0, ld_ash_worker, NULL, 0, NULL);
+                if (t) { CloseHandle(t); s_ash.started++; }
+            }
+            if (!s_ash.started) v = 0;
