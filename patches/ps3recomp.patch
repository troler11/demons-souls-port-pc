+/* Sleep to a QPC deadline with a high-resolution waitable timer (sub-ms),
+ * falling back to Sleep(1). */
+static void audio_sleep_until(long long due, const LARGE_INTEGER* qf)
+{
+    static HANDLE t = NULL; static int init = 0;
+    if (!init) {
+        init = 1;
+        t = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /*CREATE_WAITABLE_TIMER_HIGH_RESOLUTION*/,
+                                   TIMER_ALL_ACCESS);
+    }
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    const long long left = due - now.QuadPart;
+    if (left <= 0) return;
+    if (!t) { Sleep(1); return; }
+    LARGE_INTEGER rel; rel.QuadPart = -(left * 10000000LL / qf->QuadPart);   /* 100 ns units */
+    if (rel.QuadPart == 0) return;
+    if (SetWaitableTimer(t, &rel, 0, NULL, NULL, FALSE)) WaitForSingleObject(t, 20);
+    else Sleep(1);
+}
