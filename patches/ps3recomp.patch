diff --git a/libs/codec/sail_host_movie.c b/libs/codec/sail_host_movie.c
new file mode 100644
index 0000000..39a3a95
--- /dev/null
+++ b/libs/codec/sail_host_movie.c
@@ -0,0 +1,333 @@
+/*
+ * Host-side movie playback for cellSail (Windows).
+ *
+ * The SAIL player in cellSail.c decodes nothing; a title that waits a movie out
+ * then just sees it end at once. This plays the stream on the host instead:
+ *
+ *   - video: ffmpeg (SAIL_FFMPEG, default "ffmpeg" on PATH) demuxes the PAMF's
+ *     MPEG program stream and pipes RGBA frames, which go straight to the
+ *     swap chain through rsx_live_draw_present_rgba() with movie mode on;
+ *   - audio: the PAMF's LPCM track (private stream 1, sub-id 0x40: a 4-byte
+ *     header, then 48 kHz stereo s16 big-endian) is demuxed here and played
+ *     through waveOut. ffmpeg's MPEG-PS demuxer does not know that sub-stream.
+ *
+ * PAMF = a 0x800-byte "PAMF" header (its size in 2 KB units at +8) followed by
+ * an MPEG-2 program stream. Pacing is wall clock at the stream's 29.97 fps,
+ * started together with the audio.
+ */
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <mmsystem.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+
+#pragma comment(lib, "winmm.lib")
+
+extern void rsx_live_draw_set_movie_mode(int on);
+extern void rsx_live_draw_present_rgba(const uint8_t* rgba, uint32_t w, uint32_t h);
+
+#define MOV_W 1280
+#define MOV_H 720
+
+static volatile LONG s_stop, s_active;
+static HANDLE s_thread;
+static char   s_path[1024];
+static int    s_repeat;
+static void (*s_on_end)(void*);
+static void*  s_on_end_arg;
+
+static uint32_t pamf_header_size(FILE* f)
+{
+    uint8_t h[12];
+    if (fread(h, 1, 12, f) != 12 || memcmp(h, "PAMF", 4) != 0) return 0;
+    uint32_t units = ((uint32_t)h[8] << 24) | ((uint32_t)h[9] << 16) | ((uint32_t)h[10] << 8) | h[11];
+    return units ? units * 0x800u : 0x800u;
+}
+
+/* ---- audio: LPCM demux + waveOut ---------------------------------------- */
+
+#define AUD_BUFS  8
+#define AUD_BYTES (48000 * 4 / 8)      /* 125 ms per buffer */
+
+typedef struct {
+    FILE*   f;
+    uint8_t rd[1 << 16];
+    size_t  rd_len, rd_pos;
+    int     eof;
+    int     ch;            /* channels, from the LPCM header: 1, 2 or 6 */
+    uint8_t pend[4096];    /* the rest of a packet that did not fit last time */
+    size_t  pend_n, pend_pos;
+} LpcmDemux;
+
+static int lpcm_fill(LpcmDemux* d)
+{
+    if (d->eof) return 0;
+    if (d->rd_pos) {
+        memmove(d->rd, d->rd + d->rd_pos, d->rd_len - d->rd_pos);
+        d->rd_len -= d->rd_pos; d->rd_pos = 0;
+    }
+    size_t n = fread(d->rd + d->rd_len, 1, sizeof d->rd - d->rd_len, d->f);
+    if (!n) d->eof = 1;
+    d->rd_len += n;
+    return (int)n;
+}
+
+/* Next LPCM payload chunk into out (up to cap bytes); 0 at end of stream. */
+static size_t lpcm_next(LpcmDemux* d, uint8_t* out, size_t cap)
+{
+    /* A packet larger than the room left used to lose its tail: a gap in
+     * the sound at every buffer. Keep it for the next call. */
+    if (d->pend_pos < d->pend_n) {
+        size_t n = d->pend_n - d->pend_pos;
+        if (n > cap) n = cap;
+        memcpy(out, d->pend + d->pend_pos, n);
+        d->pend_pos += n;
+        return n;
+    }
+    for (;;) {
+        if (d->rd_len - d->rd_pos < 16 && !lpcm_fill(d) && d->rd_len - d->rd_pos < 16) return 0;
+        uint8_t* p = d->rd + d->rd_pos;
+        size_t avail = d->rd_len - d->rd_pos;
+        if (p[0] || p[1] || p[2] != 1) { d->rd_pos++; continue; }
+        uint8_t sid = p[3];
+        if (sid == 0xBA) { if (avail < 14) { lpcm_fill(d); continue; } d->rd_pos += 14 + (p[13] & 7); continue; }
+        if (sid == 0xB9) { d->rd_pos += 4; continue; }
+        if (sid < 0xBB) { d->rd_pos++; continue; }
+        size_t len = ((size_t)p[4] << 8) | p[5];
+        if (avail < 6 + len) { if (!lpcm_fill(d)) return 0; continue; }
+        size_t got = 0;
+        if (sid == 0xBD && len > 3) {
+            size_t pay = 9 + p[8];
+            if (pay + 4 <= 6 + len && p[pay] == 0x40) {
+                /* Header: sub-id 0x40, then the channel assignment in the high
+                 * nibble of the next byte (as Blu-ray LPCM: 1 mono, 3 stereo,
+                 * 9 = 5.1). Demon's Souls' opening ds_advertise.pam is 5.1;
+                 * played as stereo it came out at a third of the speed. */
+                { const int ca = p[pay + 1] >> 4;
+                  d->ch = ca == 1 ? 1 : ca == 9 ? 6 : 2; }
+                pay += 4;
+                got = 6 + len - pay;
+                if (got > cap) {
+                    const size_t rest = got - cap;
+                    if (rest <= sizeof d->pend) {
+                        memcpy(d->pend, p + pay + cap, rest);
+                        d->pend_n = rest; d->pend_pos = 0;
+                    }
+                    got = cap;
+                }
+                memcpy(out, p + pay, got);
+            }
+        }
+        d->rd_pos += 6 + len;
+        if (got) return got;
+    }
+}
+
+static DWORD WINAPI audio_thread(LPVOID arg)
+{
+    (void)arg;
+    FILE* f = fopen(s_path, "rb");
+    if (!f) return 0;
+    uint32_t hs = pamf_header_size(f);
+    fseek(f, (long)hs, SEEK_SET);
+    static LpcmDemux d; memset(&d, 0, sizeof d); d.f = f;
+
+    WAVEFORMATEX wf; memset(&wf, 0, sizeof wf);
+    wf.wFormatTag = WAVE_FORMAT_PCM; wf.nChannels = 2; wf.nSamplesPerSec = 48000;
+    wf.wBitsPerSample = 16; wf.nBlockAlign = 4; wf.nAvgBytesPerSec = 48000 * 4;
+    HWAVEOUT wo;
+    if (waveOutOpen(&wo, WAVE_MAPPER, &wf, 0, 0, CALLBACK_NULL) != MMSYSERR_NOERROR) { fclose(f); return 0; }
+
+    static uint8_t bufs[AUD_BUFS][AUD_BYTES];
+    static uint8_t raw[AUD_BYTES * 3];        /* up to 6 channels in */
+    WAVEHDR hdr[AUD_BUFS]; memset(hdr, 0, sizeof hdr);
+    size_t raw_n = 0;
+    d.ch = 2;
+    int done = 0;
+    while (!s_stop && !done) {
+        int queued = 0;
+        for (int b = 0; b < AUD_BUFS && !s_stop; b++) {
+            if (hdr[b].dwFlags & WHDR_PREPARED) {
+                if (!(hdr[b].dwFlags & WHDR_DONE)) { queued++; continue; }
+                waveOutUnprepareHeader(wo, &hdr[b], sizeof hdr[b]);
+            }
+            /* Read one output buffer's worth of input frames (any channel
+             * count), then convert to 16-bit LE stereo. */
+            /* The layout is known once a packet has been read. */
+            while (raw_n < sizeof raw) {
+                if (raw_n && raw_n >= (AUD_BYTES / 4) * (size_t)d.ch * 2) break;
+                size_t n = lpcm_next(&d, raw + raw_n, sizeof raw - raw_n);
+                if (!n) { done = 1; break; }
+                raw_n += n;
+            }
+            const size_t in_frame = (size_t)d.ch * 2;
+            size_t frames = raw_n / in_frame;
+            if (frames > AUD_BYTES / 4) frames = AUD_BYTES / 4;
+            if (!frames) break;
+            int16_t* o = (int16_t*)bufs[b];
+            for (size_t k = 0; k < frames; k++) {
+                const uint8_t* q = raw + k * in_frame;
+                float c[6];
+                for (int i = 0; i < d.ch; i++) c[i] = (float)(int16_t)((q[2 * i] << 8) | q[2 * i + 1]);
+                float l, r;
+                if (d.ch == 1)      { l = r = c[0]; }
+                else if (d.ch == 2) { l = c[0]; r = c[1]; }
+                else {                                   /* 5.1 -> stereo */
+                    l = 0.45f * (c[0] + 0.707f * c[2] + 0.707f * c[3] + 0.5f * c[5]);
+                    r = 0.45f * (c[1] + 0.707f * c[2] + 0.707f * c[4] + 0.5f * c[5]);
+                }
+                if (l > 32767.f) l = 32767.f; if (l < -32768.f) l = -32768.f;
+                if (r > 32767.f) r = 32767.f; if (r < -32768.f) r = -32768.f;
+                o[2 * k] = (int16_t)l; o[2 * k + 1] = (int16_t)r;
+            }
+            const size_t used = frames * in_frame;
+            memmove(raw, raw + used, raw_n - used); raw_n -= used;
+            size_t fill = frames * 4;
+            /* SAIL_AUDIO_RAW=<file>: append what goes to the speakers
+             * (s16le stereo 48 kHz), to check movie sound without ears. */
+            { static FILE* rf = (FILE*)-1;
+              if (rf == (FILE*)-1) { const char* e = getenv("SAIL_AUDIO_RAW"); rf = e ? fopen(e, "ab") : NULL; }
+              if (rf) { fwrite(bufs[b], 1, fill, rf); fflush(rf); } }
+            memset(&hdr[b], 0, sizeof hdr[b]);
+            hdr[b].lpData = (LPSTR)bufs[b]; hdr[b].dwBufferLength = (DWORD)fill;
+            waveOutPrepareHeader(wo, &hdr[b], sizeof hdr[b]);
+            waveOutWrite(wo, &hdr[b], sizeof hdr[b]);
+            queued++;
+            if (done) break;
+        }
+        if (queued >= AUD_BUFS || done) Sleep(20);
+    }
+    if (s_stop) waveOutReset(wo);
+    else for (int b = 0; b < AUD_BUFS; b++)                          /* drain */
+        while ((hdr[b].dwFlags & WHDR_PREPARED) && !(hdr[b].dwFlags & WHDR_DONE) && !s_stop) Sleep(10);
+    waveOutReset(wo);
+    for (int b = 0; b < AUD_BUFS; b++)
+        if (hdr[b].dwFlags & WHDR_PREPARED) waveOutUnprepareHeader(wo, &hdr[b], sizeof hdr[b]);
+    waveOutClose(wo);
+    fclose(f);
+    return 0;
+}
+
+/* ---- video: ffmpeg pipe ------------------------------------------------- */
+
+static int play_once(void)
+{
+    FILE* f = fopen(s_path, "rb");
+    if (!f) { fprintf(stderr, "[sail-movie] cannot open %s\n", s_path); return 0; }
+    uint32_t hs = pamf_header_size(f);
+    fclose(f);
+
+    const char* ff = getenv("SAIL_FFMPEG");
+    if (!ff || !*ff) ff = "ffmpeg";
+    char cmd[2048];
+    snprintf(cmd, sizeof cmd,
+             "\"%s\" -v error -nostdin -skip_initial_bytes %u -f mpeg -i \"%s\" -an "
+             "-vf scale=%d:%d -f rawvideo -pix_fmt rgba -",
+             ff, hs, s_path, MOV_W, MOV_H);
+
+    SECURITY_ATTRIBUTES sa = { sizeof sa, NULL, TRUE };
+    HANDLE rd = NULL, wr = NULL;
+    if (!CreatePipe(&rd, &wr, &sa, 1 << 22)) return 0;
+    SetHandleInformation(rd, HANDLE_FLAG_INHERIT, 0);
+    STARTUPINFOA si; memset(&si, 0, sizeof si); si.cb = sizeof si;
+    si.dwFlags = STARTF_USESTDHANDLES;
+    si.hStdOutput = wr; si.hStdError = GetStdHandle(STD_ERROR_HANDLE); si.hStdInput = NULL;
+    PROCESS_INFORMATION pi; memset(&pi, 0, sizeof pi);
+    if (!CreateProcessA(NULL, cmd, NULL, NULL, TRUE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi)) {
+        fprintf(stderr, "[sail-movie] cannot start ffmpeg (%lu): %s\n", GetLastError(), cmd);
+        CloseHandle(rd); CloseHandle(wr); return 0;
+    }
+    CloseHandle(wr);
+    fprintf(stderr, "[sail-movie] playing %s\n", s_path);
+
+    HANDLE at = CreateThread(NULL, 0, audio_thread, NULL, 0, NULL);
+    const size_t fb = (size_t)MOV_W * MOV_H * 4;
+    uint8_t* frame = (uint8_t*)malloc(fb);
+    LARGE_INTEGER fq, t0, now; QueryPerformanceFrequency(&fq); QueryPerformanceCounter(&t0);
+    unsigned long long k = 0;
+    int ok = 1;
+    while (!s_stop && frame) {
+        size_t got = 0;
+        while (got < fb) {
+            DWORD n = 0;
+            if (!ReadFile(rd, frame + got, (DWORD)(fb - got), &n, NULL) || !n) { ok = 0; break; }
+            got += n;
+        }
+        if (got < fb) break;
+        /* frame k is due at k * 1001/30000 s */
+        const double due = (double)k * 1001.0 / 30000.0;
+        for (;;) {
+            QueryPerformanceCounter(&now);
+            const double el = (double)(now.QuadPart - t0.QuadPart) / (double)fq.QuadPart;
+            if (el >= due || s_stop) break;
+            Sleep((DWORD)((due - el) * 1000.0 > 2 ? (due - el) * 1000.0 - 1 : 0));
+        }
+        rsx_live_draw_present_rgba(frame, MOV_W, MOV_H);
+        /* SAIL_DUMP=<dir>: every 300th movie frame as .ppm, for headless checks. */
+        { static const char* dd = (const char*)-1;
+          if (dd == (const char*)-1) dd = getenv("SAIL_DUMP");
+          if (dd && k % 300 == 0) {
+              char p[1200]; snprintf(p, sizeof p, "%s\\movie_%06llu.ppm", dd, k);
+              FILE* o = fopen(p, "wb");
+              if (o) { fprintf(o, "P6\n%d %d\n255\n", MOV_W, MOV_H);
+                       for (size_t i = 0; i < (size_t)MOV_W * MOV_H; i++) fwrite(frame + i * 4, 1, 3, o);
+                       fclose(o); }
+              fprintf(stderr, "[sail-movie] frame %llu\n", k);
+          } }
+        k++;
+    }
+    (void)ok;
+    free(frame);
+    TerminateProcess(pi.hProcess, 0);
+    CloseHandle(pi.hProcess); CloseHandle(pi.hThread);
+    CloseHandle(rd);
+    if (at) { if (!s_stop) WaitForSingleObject(at, 2000); else WaitForSingleObject(at, 1000); CloseHandle(at); }
+    fprintf(stderr, "[sail-movie] %s after %llu frames\n", s_stop ? "stopped" : "finished", k);
+    return k > 0;
+}
+
+static DWORD WINAPI movie_thread(LPVOID arg)
+{
+    (void)arg;
+    rsx_live_draw_set_movie_mode(1);
+    do {
+        if (!play_once()) break;
+    } while (s_repeat && !s_stop);
+    rsx_live_draw_set_movie_mode(0);
+    const int natural = !s_stop;
+    InterlockedExchange(&s_active, 0);
+    if (natural && s_on_end) s_on_end(s_on_end_arg);
+    return 0;
+}
+
+void sail_movie_stop(void)
+{
+    if (!s_thread) return;
+    InterlockedExchange(&s_stop, 1);
+    WaitForSingleObject(s_thread, 5000);
+    CloseHandle(s_thread); s_thread = NULL;
+}
+
+int sail_movie_start(const char* host_path, int repeat, void (*on_end)(void*), void* arg)
+{
+    sail_movie_stop();
+    snprintf(s_path, sizeof s_path, "%s", host_path);
+    s_repeat = repeat; s_on_end = on_end; s_on_end_arg = arg;
+    InterlockedExchange(&s_stop, 0);
+    InterlockedExchange(&s_active, 1);
+    s_thread = CreateThread(NULL, 1 << 20, movie_thread, NULL, 0, NULL);
+    return s_thread != NULL;
+}
+
+void sail_movie_set_repeat(int repeat) { s_repeat = repeat; }
+int  sail_movie_active(void) { return s_active != 0; }
+
+#else
+int  sail_movie_start(const char* p, int r, void (*e)(void*), void* a) { (void)p; (void)r; (void)e; (void)a; return 0; }
+void sail_movie_stop(void) {}
+void sail_movie_set_repeat(int r) { (void)r; }
+int  sail_movie_active(void) { return 0; }
+#endif
