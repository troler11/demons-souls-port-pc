+        fflush(stderr);
+        abort(); /* Shared fallback state would silently corrupt DMA completion. */
+    }
+    slot->ctx = ctx;
+    mfc_engine_init(&slot->mfc);
+    slot->next = s_mfc_slots;
+    s_mfc_slots = slot;
+    ReleaseSRWLockExclusive(&s_mfc_claim_lock);
