+        if (p->fence > done) { if (keep != i) s_zp.pend[keep] = *p; keep++; continue; }
+        if (!r && FAILED(s_zp.rb->lpVtbl->Map(s_zp.rb, 0, &rr, (void**)&r))) { r = NULL; break; }
+        u64 sum = 0;
