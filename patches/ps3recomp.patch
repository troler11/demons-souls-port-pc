+/* LD_GPU_PROF=1: GPU time of every submitted command list (a timestamp at its
+ * start and its end), summed per guest frame. Every 5 s: GPU busy time per
+ * frame (average / max / frames over 16.7 ms) and per flush reason -- tells a
+ * frame the GPU is slow on from one the CPU is late with. Off by default. */
+enum { GT_SLOTS = 2048 };
+static struct {
+    int enabled, cur, next, tail;
+    ID3D12QueryHeap* heap;
+    ID3D12Resource* readback;
+    u64* values;
+    u64 frequency, fence[GT_SLOTS];
+    u32 frame[GT_SLOTS];
+    u8 reason[GT_SLOTS];
+    u32 open_frame;
+    double open_busy;
+    double frames, busy_sum, busy_max, over, lists;
+    double by_reason[LD_FLUSH_REASON_COUNT];
+    double report_at;
+} s_gt = {.enabled = -1, .cur = -1};
+
+static void ld_gt_report(void)
+{
+    static const char* names[LD_FLUSH_REASON_COUNT] = { "present", "guest_ref", "vring",
+        "vcring", "retire", "movie", "movie_present", "readback", "pcring", "descring", "shutdown" };
+    char line[1024];
+    int p = snprintf(line, sizeof line,
+        "[gpu-time] 5s frames=%.0f busy/frame avg=%.2fms max=%.2fms over16.7=%.0f lists/frame=%.1f |",
+        s_gt.frames, s_gt.frames ? s_gt.busy_sum / s_gt.frames : 0, s_gt.busy_max, s_gt.over,
+        s_gt.frames ? s_gt.lists / s_gt.frames : 0);
+    for (int i = 0; i < LD_FLUSH_REASON_COUNT; i++)
+        if (s_gt.by_reason[i] > 0.05)
+            p += snprintf(line + p, sizeof line - (size_t)p, " %s=%.0fms", names[i], s_gt.by_reason[i]);
+    fprintf(stderr, "%s\n", line);
+    s_gt.frames = s_gt.busy_sum = s_gt.busy_max = s_gt.over = s_gt.lists = 0;
+    memset(s_gt.by_reason, 0, sizeof s_gt.by_reason);
+}
+
+/* Fold in every finished list, oldest first (one queue: they finish in order). */
+static void ld_gt_collect(void)
+{
+    const u64 completed = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    while (s_gt.fence[s_gt.tail] && s_gt.fence[s_gt.tail] <= completed) {
+        const int i = s_gt.tail;
+        const double ms = (double)(s_gt.values[i * 2 + 1] - s_gt.values[i * 2]) * 1000.0 /
+                          (double)s_gt.frequency;
+        if (s_gt.frame[i] != s_gt.open_frame) {
+            if (s_gt.open_busy > 0) {
+                s_gt.frames++;
+                s_gt.busy_sum += s_gt.open_busy;
+                if (s_gt.open_busy > s_gt.busy_max) s_gt.busy_max = s_gt.open_busy;
+                if (s_gt.open_busy > 16.7) s_gt.over++;
+            }
+            s_gt.open_frame = s_gt.frame[i];
+            s_gt.open_busy = 0;
+        }
+        if (ms > 0 && ms < 1000.0) {
+            s_gt.open_busy += ms;
+            s_gt.by_reason[s_gt.reason[i] < LD_FLUSH_REASON_COUNT ? s_gt.reason[i] : 0] += ms;
+        }
+        s_gt.lists++;
+        s_gt.fence[i] = 0;
+        s_gt.tail = (s_gt.tail + 1) % GT_SLOTS;
+    }
+    const double now = ld_prof_ms();
+    if (!s_gt.report_at) s_gt.report_at = now + 5000.0;
+    if (now >= s_gt.report_at) { ld_gt_report(); s_gt.report_at = now + 5000.0; }
+}
