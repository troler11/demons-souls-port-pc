+    int inited, ok;
+    ID3D12QueryHeap* heap;
+    ID3D12Resource*  rb;          /* ZP_SLOTS x u64 readback */
+    u32 next_slot;
+    int enabled;                  /* guest: counting on */
+    int active; u16 active_slot;  /* a query is open in g.list */
+    u32 nseg; u16 seg[ZP_SEGS];   /* closed segments since the last CLEAR */
+    zp_pending_t pend[ZP_PENDING]; u32 npend;
