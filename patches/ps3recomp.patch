+/* p + z with its exact rounding error (TwoSum); the product is exact in double */
+SPU__XS_INLINE __m128d spu__xs_twosum(__m128d p, __m128d z, __m128d* err) {
+    const __m128d s = _mm_add_pd(p, z), bb = _mm_sub_pd(s, p);
+    *err = _mm_add_pd(_mm_sub_pd(p, _mm_sub_pd(s, bb)), _mm_sub_pd(z, bb));
+    return s;
+}
+SPU__XS_INLINE u128 spu__xs_fma_exact2(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc, int rz) {
+    const __m128i xa = spu__xs_ld(a), y = spu__xs_ld(b), zc = spu__xs_ld(c);
+    const __m128i x = _mm_xor_si128(xa, _mm_set1_epi32((int)negp)), z = _mm_xor_si128(zc, _mm_set1_epi32((int)negc));
+    __m128i oklo, okhi, zlo, zhi;
+    __m128d elo, ehi;
+    __m128d slo, shi;
+    if (rz) {    /* the double sum truncates toward zero: trunc24(trunc53(v)) = trunc24(v) */
+        slo = _mm_add_pd(_mm_mul_pd(spu__xs_lo(x), spu__xs_lo(y)), spu__xs_lo(z));
+        shi = _mm_add_pd(_mm_mul_pd(spu__xs_hi(x), spu__xs_hi(y)), spu__xs_hi(z));
+    } else {
+        slo = spu__xs_twosum(_mm_mul_pd(spu__xs_lo(x), spu__xs_lo(y)), spu__xs_lo(z), &elo);
+        shi = spu__xs_twosum(_mm_mul_pd(spu__xs_hi(x), spu__xs_hi(y)), spu__xs_hi(z), &ehi);
+    }
+    const __m128 lo = spu__xs_trunc0(slo, rz ? NULL : &elo, &oklo, &zlo);
+    const __m128 hi = spu__xs_trunc0(shi, rz ? NULL : &ehi, &okhi, &zhi);
+    const __m128i ok = _mm_and_si128(_mm_and_si128(_mm_and_si128(spu__xs_plain0(x), spu__xs_plain0(y)), spu__xs_plain0(z)),
+                                     spu__xs_pack(oklo, okhi));
+    __m128i r = spu__xs_pos0(spu__xs_vec(lo, hi), zlo, zhi);
+    if (!spu__xs_all4(ok)) r = spu__xs_fma_fix(r, ok, xa, y, zc, negp, negc);
+    return spu__xs_st(r);
+}
+/* Standard mode: TwoSum and the boundary test. SPU mode: the plain double sum.
+ * Any other mode (rounding bits set some other way) goes the standard way. */
+SPU__XS_INLINE u128 spu__xs_fma(u128 a, u128 b, u128 c, uint32_t negp, uint32_t negc) {
+#if defined(SPU_ASSUME_SPU_FP)
