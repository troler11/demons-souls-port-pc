+static void semp_report(LARGE_INTEGER now)
+{
+    if (!s_semp_next.QuadPart) { s_semp_next.QuadPart = now.QuadPart + 5 * s_semp_freq.QuadPart; return; }
+    if (now.QuadPart < s_semp_next.QuadPart) return;
+    s_semp_next.QuadPart = now.QuadPart + 5 * s_semp_freq.QuadPart;
+    for (int k = 0; k < 6; k++) {
+        int best = -1;
+        for (int i = 0; i < SYS_SEMAPHORE_MAX; i++)
+            if (s_semp[i].waits && (best < 0 || s_semp[i].wait_ms > s_semp[best].wait_ms)) best = i;
+        if (best < 0 || s_semp[best].wait_ms < 1.0) break;
+        semp_row* r = &s_semp[best];
+        char w[160] = "", q[160] = "";
+        for (int i = 0; i < SEMP_WHO; i++) {
+            if (r->waiter[i].name[0]) { size_t n = strlen(w); snprintf(w + n, sizeof w - n, " %s:%.0fms", r->waiter[i].name, r->waiter[i].ms); }
+            if (r->poster[i].name[0]) { size_t n = strlen(q); snprintf(q + n, sizeof q - n, " %s:%llu", r->poster[i].name, r->poster[i].n); }
+        }
+        fprintf(stderr, "[sem-prof] id=%d waits=%llu blocked=%llu wait=%.0fms max=%.1fms posts=%llu | waiters%s | posters%s\n",
+            best + 1, r->waits, r->blocked, r->wait_ms, r->max_ms, r->posts, w, q);
+        r->waits = 0; r->wait_ms = -1;   /* taken this round */
+    }
+    memset(s_semp, 0, sizeof s_semp);
+}
+static void semp_note_wait(uint32_t id, double ms)
+{
+    if (id == 0 || id > SYS_SEMAPHORE_MAX) return;
+    const char* who = semp_thread();
+    LARGE_INTEGER now; QueryPerformanceCounter(&now);
+    AcquireSRWLockExclusive(&s_semp_lock);
+    semp_row* r = &s_semp[id - 1];
+    r->waits++; if (ms > 0.05) r->blocked++;
+    r->wait_ms += ms; if (ms > r->max_ms) r->max_ms = ms;
+    semp_add(r->waiter, who, ms);
+    semp_report(now);
+    ReleaseSRWLockExclusive(&s_semp_lock);
+}
+static void semp_note_post(uint32_t id)
+{
+    if (id == 0 || id > SYS_SEMAPHORE_MAX) return;
+    const char* who = semp_thread();
+    AcquireSRWLockExclusive(&s_semp_lock);
+    s_semp[id - 1].posts++;
+    semp_add(s_semp[id - 1].poster, who, 0);
+    ReleaseSRWLockExclusive(&s_semp_lock);
+}
