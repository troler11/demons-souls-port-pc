+        }
+        __m128i a = _mm_min_epu32(_mm256_castsi256_si128(vmin), _mm256_extracti128_si256(vmin, 1));
+        __m128i b = _mm_max_epu32(_mm256_castsi256_si128(vmax), _mm256_extracti128_si256(vmax, 1));
+        a = _mm_min_epu32(a, _mm_srli_si128(a, 8)); a = _mm_min_epu32(a, _mm_srli_si128(a, 4));
+        b = _mm_max_epu32(b, _mm_srli_si128(b, 8)); b = _mm_max_epu32(b, _mm_srli_si128(b, 4));
+        mn = (uint32_t)_mm_cvtsi128_si32(a); mx = (uint32_t)_mm_cvtsi128_si32(b);
+    } else if (!is32 && count >= 16) {
+        const __m256i swap = _mm256_setr_epi8(1,0,3,2,5,4,7,6,9,8,11,10,13,12,15,14,
+            1,0,3,2,5,4,7,6,9,8,11,10,13,12,15,14);
+        const __m256i needle = _mm256_set1_epi16((int16_t)rv);
+        uint32_t active = 0;
+        const int skip_restart = restart && rv <= 0xffffu;
+        for (; count-k >= 16; k += 16) {
+            __m256i a = _mm256_shuffle_epi8(_mm256_loadu_si256((const __m256i*)(p + (size_t)k*2)), swap);
+            __m256i b = a;
+            if (skip_restart) {
+                const __m256i skip = _mm256_cmpeq_epi16(a, needle);
+                active |= ~(uint32_t)_mm256_movemask_epi8(skip);
+                a = _mm256_or_si256(a, skip); b = _mm256_andnot_si256(skip, b);
+            } else active = 1;
+            vmin = _mm256_min_epu16(vmin, a); vmax = _mm256_max_epu16(vmax, b);
+        }
+        __m128i a = _mm_min_epu16(_mm256_castsi256_si128(vmin), _mm256_extracti128_si256(vmin, 1));
+        __m128i b = _mm_max_epu16(_mm256_castsi256_si128(vmax), _mm256_extracti128_si256(vmax, 1));
+        a = _mm_min_epu16(a, _mm_srli_si128(a, 8)); a = _mm_min_epu16(a, _mm_srli_si128(a, 4));
+        a = _mm_min_epu16(a, _mm_srli_si128(a, 2));
+        b = _mm_max_epu16(b, _mm_srli_si128(b, 8)); b = _mm_max_epu16(b, _mm_srli_si128(b, 4));
+        b = _mm_max_epu16(b, _mm_srli_si128(b, 2));
+        if (active) mn = (uint32_t)_mm_cvtsi128_si32(a) & 0xffffu;
+        mx = (uint32_t)_mm_cvtsi128_si32(b) & 0xffffu;
+    }
+    /* No overread: only complete vectors above, all remaining indices here. */
+    for (; k < count; k++) {
+        uint32_t v;
+        if (is32) { memcpy(&v, p+(size_t)k*4, 4); v = __builtin_bswap32(v); }
+        else v = ((uint32_t)p[(size_t)k*2] << 8) | p[(size_t)k*2+1];
+        if (restart && v == rv) continue;
+        if (v < mn) mn = v;
+        if (v > mx) mx = v;
+    }
+    *lo = mn; *hi = mx;
+}
+#endif
+
+static void ld_index_range_scan(const uint8_t* p, uint32_t count, int is32,
+    int restart, uint32_t rv, uint32_t* lo, uint32_t* hi)
+{
+#if defined(__AVX2__)
+    if (ld_index_range_simd_enabled()) { ld_index_range_scan_avx2(p, count, is32, restart, rv, lo, hi); return; }
+#endif
+    ld_index_range_scan_scalar(p, count, is32, restart, rv, lo, hi);
+}
+
+static void ld_index_range_free(ld_ir_entry* e)
+{
+    if (e->bytes) { s_index_range.retained -= e->size; free(e->bytes); }
+    memset(e, 0, sizeof(*e));
+}
+static void ld_index_range_clear(void)
+{
+    for (uint32_t i = 0; i < LD_IR_SETS; i++)
+        for (uint32_t j = 0; j < LD_IR_WAYS; j++) ld_index_range_free(&s_index_range.entry[i][j]);
+    memset(&s_index_range, 0, sizeof(s_index_range));
+}
+
+#if defined(_MSC_VER)
+__declspec(noinline)
+#else
+__attribute__((noinline))
+#endif
+static void ld_index_range_cached(const uint8_t* p, uint32_t count, int is32,
+    int restart, uint32_t restart_value, uint32_t* lo, uint32_t* hi)
+{
+    const size_t size = (size_t)count * (is32 ? 4u : 2u);
+    uint64_t key = ((uint64_t)(uintptr_t)p >> 1) ^ ((uint64_t)count << 32);
+    key = (key ^ (key >> 29)) * 0x9e3779b97f4a7c15ull;
+    const uint32_t set = (uint32_t)(key >> 54); /* high bits distribute aligned buffers */
+    for (uint32_t i = 0; i < LD_IR_WAYS; i++) {
+        const ld_ir_entry* e = &s_index_range.entry[set][i];
+        if (e->bytes && e->address == p && e->count == count && e->is32 == (uint32_t)!!is32 &&
+            e->restart == (uint32_t)!!restart && e->restart_value == restart_value &&
+            !memcmp(e->bytes, p, size)) {
+            *lo = e->lo; *hi = e->hi; s_index_range.hits++; return;
+        }
+    }
+    s_index_range.misses++;
+    ld_index_range_scan(p, count, is32, restart, restart_value, lo, hi);
+    ld_ir_entry* e = &s_index_range.entry[set][s_index_range.next[set]++ % LD_IR_WAYS];
+    ld_index_range_free(e);
+    if (s_index_range.retained + size > LD_IR_BUDGET) { s_index_range.budget_skips++; return; }
+    uint8_t* copy = (uint8_t*)malloc(size);
+    if (!copy) return;
+    memcpy(copy, p, size);
+    e->address = p; e->bytes = copy; e->count = count; e->size = size;
+    e->is32 = !!is32; e->restart = !!restart; e->restart_value = restart_value;
+    e->lo = *lo; e->hi = *hi;
+    s_index_range.retained += size;
+}
+
+static void ld_index_range_get(const uint8_t* p, uint32_t count, int is32,
+    int restart, uint32_t restart_value, uint32_t* lo, uint32_t* hi, int cache)
+{
+    const uint64_t bytes = (uint64_t)count * (is32 ? 4u : 2u);
+    if (!cache || !count || bytes > LD_IR_MAX_SPAN) {
+        s_index_range.plain++;
+        ld_index_range_scan(p, count, is32, restart, restart_value, lo, hi);
+    } else ld_index_range_cached(p, count, is32, restart, restart_value, lo, hi);
+}
+#endif
diff --git a/libs/video/rsx_present_prof.h b/libs/video/rsx_present_prof.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_present_prof.h
@@ -0,0 +1,78 @@
+/* Guest presentation wall time, including entry-lock contention. Inert unless
+ * LD_PRESENT_PROF=1. All accumulated state is protected by the renderer entry
+ * lock; the caller's start time and CPU counter are local, before that lock.
+ * Stage totals are disjoint wall times, not GPU durations or CPU percentages.
+ * LD_POST_PROF supplies asynchronous GPU timestamps for the output passes. */
+#ifndef RSX_PRESENT_PROF_H
+#define RSX_PRESENT_PROF_H
+
+enum {
+    LPP_PREPARE, LPP_FG_WAIT, LPP_COPY, LPP_FLUSH, LPP_WRITEBACK,
+    LPP_OVERLAY, LPP_PACE, LPP_DXGI, LPP_WORKER, LPP_TAIL, LPP_COUNT
+};
+static struct {
+    double stage[LPP_COUNT], wall, lock, next;
+    u64 cpu_100ns;
+    unsigned calls, cpu_calls;
+} s_present_prof;
+
+static int ld_present_prof_on(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_PRESENT_PROF");
+        on = e && !strcmp(e, "1");
+    }
+    return on;
+}
+
+static int ld_present_thread_cpu(u64* ticks)
+{
+    FILETIME created, exited, kernel, user;
+    if (!GetThreadTimes(GetCurrentThread(), &created, &exited, &kernel, &user))
+        return 0;
+    *ticks = ((u64)kernel.dwHighDateTime << 32) + kernel.dwLowDateTime +
+             ((u64)user.dwHighDateTime << 32) + user.dwLowDateTime;
+    return 1;
+}
+
+static void ld_present_prof_mark(double* mark, int stage)
+{
+    if (*mark == 0) return;
+    const double now = ld_prof_ms();
+    s_present_prof.stage[stage] += now - *mark;
+    *mark = now;
+}
+
+static void ld_present_prof_end(double begin, double locked, u64 cpu, int cpu_ok)
+{
+    const double now = ld_prof_ms();
+    u64 end_cpu;
+    s_present_prof.wall += now - begin;
+    s_present_prof.lock += locked - begin;
+    s_present_prof.calls++;
+    if (cpu_ok && ld_present_thread_cpu(&end_cpu) && end_cpu >= cpu) {
+        s_present_prof.cpu_100ns += end_cpu - cpu;
+        s_present_prof.cpu_calls++;
+    }
+    if (!s_present_prof.next) s_present_prof.next = now + 5000.0;
+    if (now < s_present_prof.next) return;
+    double accounted = s_present_prof.lock;
+    for (int i = 0; i < LPP_COUNT; i++) accounted += s_present_prof.stage[i];
+    fprintf(stderr,
+        "[present-prof] calls=%u wall=%.1fms thread_cpu=%.1fms(cpu_calls=%u) "
+        "lock=%.1f prepare=%.1f worker_wait=%.1f copy=%.1f flush=%.1f "
+        "writeback=%.1f overlay=%.1f pace=%.1f dxgi=%.1f worker=%.1f "
+        "tail=%.1f other=%.1f\n",
+        s_present_prof.calls, s_present_prof.wall,
+        (double)s_present_prof.cpu_100ns / 10000.0, s_present_prof.cpu_calls,
+        s_present_prof.lock, s_present_prof.stage[LPP_PREPARE],
+        s_present_prof.stage[LPP_FG_WAIT], s_present_prof.stage[LPP_COPY],
+        s_present_prof.stage[LPP_FLUSH], s_present_prof.stage[LPP_WRITEBACK],
+        s_present_prof.stage[LPP_OVERLAY], s_present_prof.stage[LPP_PACE],
+        s_present_prof.stage[LPP_DXGI], s_present_prof.stage[LPP_WORKER],
+        s_present_prof.stage[LPP_TAIL], s_present_prof.wall - accounted);
+    memset(&s_present_prof, 0, sizeof(s_present_prof));
+    s_present_prof.next = now + 5000.0;
+}
+#endif
diff --git a/libs/video/rsx_present_stats.h b/libs/video/rsx_present_stats.h
new file mode 100644
--- /dev/null
+++ b/libs/video/rsx_present_stats.h
@@ -0,0 +1,71 @@
+/* Optional successful-Present interval distribution. Reuses the existing QPC
+ * ring and does no additional per-frame clock query or allocation. These are
+ * submission intervals, not display scanout or measured input latency. With
+ * FG, the ring records the first Present of each pair only. */
+#ifndef RSX_PRESENT_STATS_H
+#define RSX_PRESENT_STATS_H
+static struct {
+    int enabled;
+    u64 last;
+    LONGLONG qpc;
+    LONGLONG origin;
+    double intervals[LD_PRESENT_RING_CAP];
+} s_present_stats = { .enabled = -1 };
+
+static int ld_present_interval_compare(const void* a, const void* b)
+{
+    const double x = *(const double*)a, y = *(const double*)b;
+    return (x > y) - (x < y);
+}
+
+static void ld_present_stats_record(void)
+{
+    if (s_present_stats.enabled < 0) {
+        const char* e = getenv("LD_PRESENT_STATS");
+        s_present_stats.enabled = e && !strcmp(e, "1");
+    }
+    if (!s_present_stats.enabled || g_ld_qpc_frequency <= 0) return;
+    const u64 total = g_ld_present_total;
+    const LONGLONG now = g_ld_present_ring[(total - 1u) &
+        (LD_PRESENT_RING_CAP - 1u)].qpc;
+    if (!s_present_stats.last || total <= s_present_stats.last) {
+        s_present_stats.last = total; s_present_stats.qpc = now;
+        s_present_stats.origin = now;
+        return;
+    }
+    if (now - s_present_stats.qpc < 5 * g_ld_qpc_frequency) return;
+    u64 first = s_present_stats.last + 1u;
+    if (total >= LD_PRESENT_RING_CAP &&
+        first < total - LD_PRESENT_RING_CAP + 2u)
+        first = total - LD_PRESENT_RING_CAP + 2u;
+    unsigned n = 0;
+    unsigned over33 = 0, over50 = 0;
+    double sum = 0;
+    for (u64 id = first; id <= total; id++) {
+        const ld_present_sample* a = &g_ld_present_ring[(id - 2u) &
+            (LD_PRESENT_RING_CAP - 1u)];
+        const ld_present_sample* b = &g_ld_present_ring[(id - 1u) &
+            (LD_PRESENT_RING_CAP - 1u)];
+        if (a->present_id != id - 1u || b->present_id != id || b->qpc <= a->qpc)
+            continue;
+        const double ms = (double)(b->qpc - a->qpc) * 1000.0 /
+            (double)g_ld_qpc_frequency;
+        s_present_stats.intervals[n++] = ms; sum += ms;
+        over33 += ms > (1000.0 / 30.0);
+        over50 += ms > 50.0;
+    }
+    if (n) {
+        qsort(s_present_stats.intervals, n, sizeof(double), ld_present_interval_compare);
+        fprintf(stderr, "[present-stats] recorded=%u seconds=%.3f fps=%.3f "
+            "p50=%.3fms p95=%.3fms p99=%.3fms max=%.3fms elapsed=%.3f over33=%u over50=%u\n",
+            n, sum / 1000.0, (double)n * 1000.0 / sum,
+            s_present_stats.intervals[(n - 1u) / 2u],
+            s_present_stats.intervals[(n * 95u + 99u) / 100u - 1u],
+            s_present_stats.intervals[(n * 99u + 99u) / 100u - 1u],
+            s_present_stats.intervals[n - 1u],
+            (double)(now - s_present_stats.origin) / (double)g_ld_qpc_frequency,
+            over33, over50);
+    }
+    s_present_stats.last = total; s_present_stats.qpc = now;
+}
+#endif
