+static void zp_method(u32 m, u32 arg)
+{
+    if (g_ld_movie_mode) return;   /* see rsx_live_draw_zpass_report */
+    if (!ld_zpass_on() || !zp_init()) return;
+    if (m == 0x1D84) {                       /* SET_ZPASS_PIXEL_COUNT_ENABLE */
+        s_zp.enabled = arg & 1u;
+        if (s_zp.enabled) zp_begin(); else zp_end();
+    } else if (m == 0x17C8 && arg == 1u) {   /* CLEAR_REPORT_VALUE(ZPASS) */
+        if (s_zp.active) { zp_end(); s_zp.nseg = 0; zp_begin(); }
+        else s_zp.nseg = 0;
+    }
