+static ld_pw_entry* ld_pw_match(const WCHAR* name, const unsigned char* wire, uint32_t size)
+{
+    for (ld_pw_entry* e = s_pw.buckets[ld_pw_bucket(name)]; e; e = e->next)
+        if (!wcscmp(e->name, name) && e->size == size && !memcmp(e->wire, wire, size)) return e;
+    return NULL;
+}
+static int ld_pw_insert(ld_pw_entry* e)
+{
+    const uint64_t bytes = sizeof(*e) + (uint64_t)e->size;
+    if (s_pw.count >= s_pw.maximum || bytes > s_pw.budget || s_pw.bytes > s_pw.budget - bytes) return 0;
+    const unsigned slot = ld_pw_bucket(e->name);
