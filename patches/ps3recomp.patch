-            ctx->pc = tgt & SPU_LS_MASK & ~3u;
-            g_spu_trampoline_fn = spu_indirect_branch;
-            return 1;
-        }
-        if (op9 == 0x040 || op9 == 0x042 || op9 == 0x044 || op9 == 0x046) {
