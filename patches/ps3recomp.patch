+/* ---------------------------------------------------------------------------
+ * LD_ASYNC_SHADERS (default on; 0 = off): a shader that is in neither the
+ * in-memory nor the disk cache is compiled on a worker thread instead of on
+ * the render thread. D3DCompile takes ~20-70 ms per generated pixel shader,
+ * and Demon's Souls keeps meeting new ones in every new area, effect and boss
+ * (169 in one play session) -- each one a visible hitch. Meanwhile get_pso
+ * skips the draws that need it (the object appears a frame or two late) and
+ * does not cache the PSO as failed. The worker writes the blob to the disk
+ * cache; the next draw finds it there through the normal path. A compile that
+ * fails is retried synchronously once, so its error is logged as before.
+ * -----------------------------------------------------------------------*/
+typedef struct ld_ash_job {
+    struct ld_ash_job* next;
+    volatile LONG state;            /* 0 queued, 1 compiling, 2 done, 3 failed */
+    char stage;                     /* 'V' or 'P' */
+    u32 length;
+    u64 hash;
+    char* source;
+    ID3DBlob* blob;                 /* the result, handed to the render thread */
+} ld_ash_job;
+typedef struct { ld_ash_job* vs; ld_ash_job* ps; int pso; } ld_ash_wait;   /* pso: LD_ASYNC_PSO */
+#define LD_ASH_SLOTS 4096u
+#define LD_ASH_PENDING 256u
+static struct {
+    SRWLOCK lock;
+    CONDITION_VARIABLE cv;
+    ld_ash_job* head;
+    ld_ash_job* tail;
+    ld_ash_job* table[LD_ASH_SLOTS];         /* every job ever queued; render thread only */
+    struct { u64 key; ld_ash_wait wait; } pending[LD_ASH_PENDING];
+    u32 n_pending, n_jobs;
+    volatile LONG done, failed;
+    int started;
+} s_ash;
+
+static DWORD WINAPI ld_ash_worker(LPVOID arg)
+{
+    (void)arg;
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+    for (;;) {
+        AcquireSRWLockExclusive(&s_ash.lock);
+        while (!s_ash.head)
+            SleepConditionVariableSRW(&s_ash.cv, &s_ash.lock, INFINITE, 0);
+        ld_ash_job* job = s_ash.head;
+        s_ash.head = job->next;
+        if (!s_ash.head) s_ash.tail = NULL;
+        ReleaseSRWLockExclusive(&s_ash.lock);
+
+        InterlockedExchange(&job->state, 1);
+        ID3DBlob* blob = NULL; ID3DBlob* err = NULL;
+        const HRESULT hr = D3DCompile(
+            job->source, job->length, job->stage == 'V' ? "xvs" : "xps", NULL, NULL, "main",
+            job->stage == 'V' ? "vs_5_0" : "ps_5_0", 0, 0, &blob, &err);
+        if (SUCCEEDED(hr) && blob)
+            shader_disk_cache_store((u32)job->stage, job->source, job->length, job->hash, blob);
+        /* Kept for the render thread: reading the fresh file back cost 8-27 ms
+         * (the file is new, and gets scanned on first open). */
+        if (SUCCEEDED(hr) && blob) job->blob = blob;
+        else if (blob) blob->lpVtbl->Release(blob);
+        if (err) err->lpVtbl->Release(err);
+        free(job->source);
+        job->source = NULL;
+        InterlockedIncrement(SUCCEEDED(hr) ? &s_ash.done : &s_ash.failed);
+        InterlockedExchange(&job->state, SUCCEEDED(hr) ? 2 : 3);
+    }
