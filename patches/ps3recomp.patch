+    const __m128 lo = spu__xs_trunc0(_mm_add_pd(spu__xs_lo(x), spu__xs_lo(y)), NULL, &oklo, &zlo);
+    const __m128 hi = spu__xs_trunc0(_mm_add_pd(spu__xs_hi(x), spu__xs_hi(y)), NULL, &okhi, &zhi);
+    const __m128i ok = _mm_and_si128(pre, spu__xs_pack(oklo, okhi));
+    __m128i r = spu__xs_pos0(spu__xs_vec(lo, hi), zlo, zhi);
+    if (!spu__xs_all4(ok)) r = spu__xs_fa_fix(r, ok, xa, yb, negb);
+    return spu__xs_st(r);
+}
+SPU__XS_INLINE u128 spu__xs_fm_exact(u128 a, u128 b) {
+    const __m128i x = spu__xs_ld(a), y = spu__xs_ld(b);
+    __m128i oklo, okhi, zlo, zhi;
+    const __m128 lo = spu__xs_trunc0(_mm_mul_pd(spu__xs_lo(x), spu__xs_lo(y)), NULL, &oklo, &zlo);
+    const __m128 hi = spu__xs_trunc0(_mm_mul_pd(spu__xs_hi(x), spu__xs_hi(y)), NULL, &okhi, &zhi);
+    const __m128i ok = _mm_and_si128(_mm_and_si128(spu__xs_plain0(x), spu__xs_plain0(y)), spu__xs_pack(oklo, okhi));
+    __m128i r = spu__xs_pos0(spu__xs_vec(lo, hi), zlo, zhi);
+    if (!spu__xs_all4(ok)) r = spu__xs_fm_fix(r, ok, x, y);
+    return spu__xs_st(r);
+}
+/* The SPU's own float mode on the host. Single-precision SPU arithmetic truncates
+ * (rounds toward zero), reads a denormal operand as zero and flushes a denormal
+ * result to zero -- exactly MXCSR's RZ rounding with FTZ and DAZ. spu_run_with_halt
+ * puts an SPU thread in that mode while it runs SPU code (spu_fp_mode_enter); then
+ * fa/fs/fm are one SSE instruction when no lane can leave the normal range (the
+ * SPU has no infinity: biased exponent 255 is ordinary extended range, which the
+ * host would turn into Inf/NaN). Every other case -- an extended-range operand, a
+ * possible overflow, or code not running in that mode -- takes the exact path,
+ * in the host's standard mode. tests/test_spu_float_neon.c checks both modes bit
+ * for bit against the scalar references. */
+/* SPU_ASSUME_SPU_FP: the build promises the code runs in the SPU float mode,
+ * so the check is a constant. Lifted code always does (spu_run_with_halt sets
+ * the mode for every run, and the fix-ups restore it after their span); it
+ * saves a stmxcsr and a branch on every float op. Such a build cannot use
+ * SPU_FAST_FP=0 for its lifted code. */
+#if defined(SPU_ASSUME_SPU_FP)
+SPU__XS_INLINE int spu__fp_spu_mode(void) { return 1; }
+#else
+SPU__XS_INLINE int spu__fp_spu_mode(void) { return (_mm_getcsr() & SPU_MXCSR_SPU_BITS) == SPU_MXCSR_SPU_BITS; }
+#endif
+/* The vector exact paths do their arithmetic in double where it is exact (a sum
+ * of singles less than 30 binades apart, a product of two singles), so they
+ * hold in either mode; their scalar fix-ups switch to the standard mode. */
+SPU__XS_SLOW u128 spu__xs_fa_std(u128 a, u128 b, uint32_t negb) { return spu__xs_fa_exact(a, b, negb); }
+SPU__XS_SLOW u128 spu__xs_fm_std(u128 a, u128 b) { return spu__xs_fm_exact(a, b); }
+/* the sign cleared where the result is zero (the SPU never produces -0) */
+SPU__XS_INLINE __m128 spu__xs_pos0f(__m128 r) {
+    return _mm_andnot_ps(_mm_and_ps(_mm_cmpeq_ps(r, _mm_setzero_ps()), _mm_castsi128_ps(_mm_set1_epi32((int)0x80000000u))), r);
+}
+SPU__XS_INLINE u128 spu__xs_fa(u128 a, u128 b, uint32_t negb) {
+    if (spu__fp_spu_mode()) {
+        const __m128i x = spu__xs_ld(a), y = _mm_xor_si128(spu__xs_ld(b), _mm_set1_epi32((int)negb));
+        /* both below 2^127 (biased exponent <= 253; 0 is a zero or a denormal, read as zero):
+         * the sum stays below 2^128 and truncation never rounds up */
+        const __m128i big = _mm_or_si128(_mm_cmpgt_epi32(spu__xs_bexp(x), _mm_set1_epi32(253)),
+                                         _mm_cmpgt_epi32(spu__xs_bexp(y), _mm_set1_epi32(253)));
+        const __m128i r = _mm_castps_si128(spu__xs_pos0f(_mm_add_ps(_mm_castsi128_ps(x), _mm_castsi128_ps(y))));
+        if (_mm_testz_si128(big, big))
+            return spu__xs_st(r);
+        /* Only the out-of-range lanes take the exact scalar path. Scalar SPU
+         * code leaves garbage (often biased exponent 255) in the lanes it
+         * does not use, and sending the whole vector down the exact path for
+         * that made Demon's Souls' audio mixer too slow for real time. */
+        return spu__xs_st(spu__xs_fa_fixz(r, _mm_xor_si128(big, _mm_set1_epi32(-1)),
+                                         spu__xs_ld(a), spu__xs_ld(b), negb));
+    }
+    return spu__xs_fa_std(a, b, negb);
+}
+SPU__XS_INLINE u128 spu_fa(u128 a, u128 b) { return spu__xs_fa(a, b, 0); }
+SPU__XS_INLINE u128 spu_fs(u128 a, u128 b) { return spu__xs_fa(a, b, 0x80000000u); }
+SPU__XS_INLINE u128 spu_fm(u128 a, u128 b) {
+    if (spu__fp_spu_mode()) {
+        const __m128i x = spu__xs_ld(a), y = spu__xs_ld(b);
+        const __m128i ex = spu__xs_bexp(x), ey = spu__xs_bexp(y);
+        /* each below 2^127 and the product below 2^128: biased exponents summing to at most 380 */
+        const __m128i big = _mm_or_si128(_mm_or_si128(_mm_cmpgt_epi32(ex, _mm_set1_epi32(253)),
+                                                      _mm_cmpgt_epi32(ey, _mm_set1_epi32(253))),
+                                         _mm_cmpgt_epi32(_mm_add_epi32(ex, ey), _mm_set1_epi32(380)));
+        const __m128i r = _mm_castps_si128(spu__xs_pos0f(_mm_mul_ps(_mm_castsi128_ps(x), _mm_castsi128_ps(y))));
+        if (_mm_testz_si128(big, big))
+            return spu__xs_st(r);
+        return spu__xs_st(spu__xs_fm_fixz(r, _mm_xor_si128(big, _mm_set1_epi32(-1)), x, y));   /* see spu__xs_fa */
+    }
