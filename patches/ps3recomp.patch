+                    r.id, r.fd, (unsigned long long)r.offset, (unsigned long long)r.size, n);
+        if (r.cb_opd) ps3_invoke_guest(r.cb_opd, r.aio, (uint64_t)(int64_t)err,
+                                       (uint64_t)(int64_t)r.id, (uint64_t)n, 0, 0, 0, 0);
