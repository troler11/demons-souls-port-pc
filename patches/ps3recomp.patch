+/* Called by the FIFO walker at GET_REPORT type 1. Returns 1 when the value
+ * will be delivered later through gcm_zpass_deliver. */
+static int rsx_live_draw_zpass_report_unlocked(u32 off, int main_mem)
+{
+    /* During a host movie the movie thread owns g.list (it records and
+     * presents the frames); the walker must not touch it from here. Recording
+     * a query from both threads corrupted the list: Close failed with
+     * E_FAIL right after the title movie and the renderer shut down. */
+    if (g_ld_movie_mode) return 0;
+    if (!ld_zpass_on() || !g.ready || !zp_init()) return 0;
+    zp_poll();
+    if (s_zp.npend >= ZP_PENDING) return 0;
+    const int was = s_zp.active;
+    if (was) zp_end();
+    zp_pending_t* p = &s_zp.pend[s_zp.npend++];
+    p->off = off; p->main_mem = main_mem; p->fence = g.fence_value + 1;   /* the next flush */
+    p->n = s_zp.nseg;
+    memcpy(p->slot, s_zp.seg, s_zp.nseg * sizeof(u16));
+    if (was) zp_begin();
+    return 1;
+}
