+static void semp_add(semp_who* who, const char* name, double ms)
+{
+    int slot = -1, least = 0;
+    for (int i = 0; i < SEMP_WHO; i++) {
+        if (who[i].name[0] && !strcmp(who[i].name, name)) { slot = i; break; }
+        if (!who[i].name[0] && slot < 0) { slot = i; strcpy(who[i].name, name); break; }
+        if (who[i].ms < who[least].ms) least = i;
+    }
+    if (slot < 0) { slot = least; strcpy(who[slot].name, "(others)"); }
+    who[slot].ms += ms; who[slot].n++;
