+/* PS3_SAMPLE_UNWIND=1 (with PS3_SAMPLE_MAIN [+ PS3_SAMPLE_THREAD]): attribute
+ * each sample by a real unwind instead of a stack scan. The runtime, CRT and
+ * system DLLs carry .pdata, so RtlVirtualUnwind walks from wherever the
+ * thread is (a runtime helper, a syscall, a kernel wait) to the exact return
+ * address inside lifted code; lifted code itself is never unwound (it has no
+ * .pdata), the walk stops at its first frame. Per sample:
+ *   where   guest (RIP in lifted code), exe (runtime/backend) or system DLL;
+ *   guest   the lifted function that owns the time: RIP's own, or the first
+ *           lifted caller above runtime/system frames (inclusive time);
+ *   host    the first exe frame that is not lifted code (which runtime
+ *           function: vm helpers, a syscall, the SPU coherency code...).
+ * Every report resets all buckets. Names: func_<guest> is the link-map
+ * symbol; identical-code folding can merge trivial bodies, so a hot empty
+ * stub still means "some trivial function". Host RVAs resolve against the
+ * map (scripts/profile_symbols.py). */
+#define SU_G 8192
+#define SU_H 4096
+static uint32_t s_su_g[SU_G]; static uint64_t s_su_incl[SU_G], s_su_self[SU_G];
+static uint32_t s_su_h[SU_H]; static uint64_t s_su_hn[SU_H];
+static uint64_t s_su_total, s_su_guest, s_su_exe, s_su_sys, s_su_lost;
+static int samp_unwind_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("PS3_SAMPLE_UNWIND") ? 1 : 0;
+    return on;
+}
+static void su_hit_g(uint32_t g, int self)
+{
+    const uint32_t key = g + 1;
+    for (uint32_t i = (key * 2654435761u) % SU_G, n = 0; n < SU_G; n++, i = (i + 1) % SU_G) {
+        if (s_su_g[i] == key || !s_su_g[i]) {
+            s_su_g[i] = key; s_su_incl[i]++; if (self) s_su_self[i]++; return;
+        }
+    }
+}
+static void su_hit_h(uint32_t rva)
+{
+    const uint32_t key = rva + 1;
+    for (uint32_t i = (key * 2654435761u) % SU_H, n = 0; n < SU_H; n++, i = (i + 1) % SU_H) {
+        if (s_su_h[i] == key) { s_su_hn[i]++; return; }
+        if (!s_su_h[i]) { s_su_h[i] = key; s_su_hn[i] = 1; return; }
+    }
+}
+/* Names come from the link map next to the exe (<exe>.map, /MAP), loaded once:
+ * it lists every lifted function (func_<guest>, spu_<image>_spu_func_<ls>),
+ * where the sampler's own table only has the registered entries, so a
+ * function missing from that table was blamed on the entry before it. */
+struct SuSym { uint32_t rva; uint8_t kind; const char* name; };   /* kind 1 PPU, 2 SPU, 0 host */
+static SuSym* s_su_sym; static size_t s_su_nsym;
+static void su_load_map(void)
+{
+    static int tried; if (tried) return; tried = 1;
+    char path[MAX_PATH]; DWORD n = GetModuleFileNameA(NULL, path, MAX_PATH);
+    if (!n || n >= MAX_PATH - 4) return;
+    char* dot = strrchr(path, '.'); if (!dot) return; strcpy(dot, ".map");
+    FILE* f = fopen(path, "r"); if (!f) { fprintf(stderr, "[samp-u] no link map at %s\n", path); return; }
+    size_t cap = 1 << 18; s_su_sym = (SuSym*)malloc(cap * sizeof(SuSym));
+    char line[1024]; unsigned long long base = 0x140000000ull;
+    while (s_su_sym && fgets(line, sizeof line, f)) {
+        unsigned long long b;
+        if (sscanf(line, " Preferred load address is %llx", &b) == 1) { base = b; continue; }
+        unsigned sec, off; char name[768]; unsigned long long va;
+        if (sscanf(line, " %x:%x %767s %llx", &sec, &off, name, &va) != 4 || va < base) continue;
+        if (s_su_nsym == cap) { cap *= 2; SuSym* g = (SuSym*)realloc(s_su_sym, cap * sizeof(SuSym)); if (!g) break; s_su_sym = g; }
+        SuSym* e = &s_su_sym[s_su_nsym++];
+        e->rva = (uint32_t)(va - base);
+        e->kind = strstr(name, "_spu_func_") ? 2 : (!strncmp(name, "?func_", 6) || !strncmp(name, "func_", 5)) ? 1 : 0;
+        e->name = _strdup(name);
+    }
+    fclose(f);
+    qsort(s_su_sym, s_su_nsym, sizeof(SuSym), [](const void* a, const void* b) -> int {
+        uint32_t x = ((const SuSym*)a)->rva, y = ((const SuSym*)b)->rva; return x < y ? -1 : x > y; });
+    fprintf(stderr, "[samp-u] link map: %zu symbols\n", s_su_nsym);
+}
+static const SuSym* su_sym(uint32_t rva)
+{
+    size_t lo = 0, hi = s_su_nsym;
+    while (lo < hi) { size_t m = (lo + hi) / 2; if (s_su_sym[m].rva <= rva) lo = m + 1; else hi = m; }
+    return lo ? &s_su_sym[lo - 1] : NULL;
+}
+static void samp_unwind_sample(HANDLE h)
+{
+    static uintptr_t base, end;
+    if (!base) {
+        base = (uintptr_t)GetModuleHandleA(NULL);
+        const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(base + ((const IMAGE_DOS_HEADER*)base)->e_lfanew);
+        end = base + nt->OptionalHeader.SizeOfImage;
+    }
+    CONTEXT c; c.ContextFlags = CONTEXT_FULL;
+    if (!GetThreadContext(h, &c)) return;
+    s_su_total++;
+    const SuSym* sym = c.Rip >= base && c.Rip < end ? su_sym((uint32_t)(c.Rip - base)) : NULL;
+    if (sym && sym->kind) { s_su_guest++; su_hit_g((uint32_t)(sym - s_su_sym), 1); return; }
+    if (c.Rip >= base && c.Rip < end) s_su_exe++; else s_su_sys++;
+    int host_done = 0;
+    __try {
+        for (int depth = 0; depth < 64 && c.Rip; depth++) {
+            if (c.Rip >= base && c.Rip < end) {
+                sym = su_sym((uint32_t)(c.Rip - base));
+                if (sym && sym->kind) { su_hit_g((uint32_t)(sym - s_su_sym), 0); return; }
+                if (!host_done) { su_hit_h(sym ? (uint32_t)(sym - s_su_sym) : 0xFFFFFFFEu); host_done = 1; }
+            }
+            DWORD64 img = 0;
+            RUNTIME_FUNCTION* rf = RtlLookupFunctionEntry(c.Rip, &img, NULL);
+            if (!rf) { c.Rip = *(const DWORD64*)c.Rsp; c.Rsp += 8; continue; }   /* leaf */
+            void* hd = NULL; DWORD64 fr = 0;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, rf, &c, &hd, &fr, NULL);
+        }
+    } __except (EXCEPTION_EXECUTE_HANDLER) {}
+    s_su_lost++;
+}
+static void samp_unwind_report(void)
+{
+    const double t = s_su_total ? (double)s_su_total : 1.0;
+    fprintf(stderr, "[samp-u] %llu samples: rip in guest %.1f%%, exe %.1f%%, system %.1f%%, no guest frame %.1f%%\n",
+            (unsigned long long)s_su_total, 100.0 * s_su_guest / t, 100.0 * s_su_exe / t,
+            100.0 * s_su_sys / t, 100.0 * s_su_lost / t);
+    for (int rank = 0; rank < 30; rank++) {
+        int bi = -1;
+        for (int k = 0; k < SU_G; k++) if (s_su_incl[k] && (bi < 0 || s_su_incl[k] > s_su_incl[bi])) bi = k;
+        if (bi < 0) break;
+        fprintf(stderr, "[samp-u] guest %s incl=%llu self=%llu\n", s_su_sym[s_su_g[bi] - 1].name,
+                (unsigned long long)s_su_incl[bi], (unsigned long long)s_su_self[bi]);
+        s_su_incl[bi] = 0;
+    }
+    for (int rank = 0; rank < 20; rank++) {
+        int bi = -1;
+        for (int k = 0; k < SU_H; k++) if (s_su_hn[k] && (bi < 0 || s_su_hn[k] > s_su_hn[bi])) bi = k;
+        if (bi < 0) break;
+        const uint32_t k = s_su_h[bi] - 1;
+        fprintf(stderr, "[samp-u] host %s n=%llu\n", k < s_su_nsym ? s_su_sym[k].name : "(unknown)", (unsigned long long)s_su_hn[bi]);
+        s_su_hn[bi] = 0;
+    }
+    memset(s_su_g, 0, sizeof s_su_g); memset(s_su_incl, 0, sizeof s_su_incl); memset(s_su_self, 0, sizeof s_su_self);
+    memset(s_su_h, 0, sizeof s_su_h); memset(s_su_hn, 0, sizeof s_su_hn);
+    s_su_total = s_su_guest = s_su_exe = s_su_sys = s_su_lost = 0;
+    fflush(stderr);
+}
