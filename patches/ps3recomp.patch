+static ID3D12PipelineState* ld_pw_find(const D3D12_GRAPHICS_PIPELINE_STATE_DESC* p)
+{
+    if (!s_pw.device || !s_pw.enabled) return NULL;
+    uint32_t n; unsigned char* wire = ld_pw_encode(p, &n); WCHAR name[64];
+    if (!wire) return NULL;
