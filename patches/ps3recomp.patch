+    if (queue_id == 0 || queue_id > SYS_EVENT_QUEUE_MAX) return (int32_t)CELL_ESRCH;
+    sys_event_queue_info* q = &g_sys_event_queues[queue_id - 1];
+    if (!q->active) return (int32_t)CELL_ESRCH;
+    int32_t rc = (int32_t)CELL_OK;
+#ifdef _WIN32
+    EnterCriticalSection(&q->lock);
+    while (q->count == 0 && block && q->active && !q->cancelled)
+        SleepConditionVariableCS(&q->not_empty, &q->lock, 50);
+#else
+    pthread_mutex_lock(&q->lock);
+    while (q->count == 0 && block && q->active && !q->cancelled) {
+        struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts);
+        ts.tv_nsec += 50000000L; if (ts.tv_nsec >= 1000000000L) { ts.tv_sec++; ts.tv_nsec -= 1000000000L; }
+        pthread_cond_timedwait(&q->not_empty, &q->lock, &ts);
+    }
+#endif
+    if (q->count > 0) {
+        *out = q->buffer[q->head];
+        q->head = (q->head + 1) % q->capacity;
+        q->count--;
+    } else {
+        rc = block ? (int32_t)CELL_ECANCELED : (int32_t)CELL_EBUSY;
+    }
+#ifdef _WIN32
+    LeaveCriticalSection(&q->lock);
+#else
+    pthread_mutex_unlock(&q->lock);
+#endif
+    return rc;
+}
