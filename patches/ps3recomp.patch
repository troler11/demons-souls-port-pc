+        return spu__xs_st(spu__xs_fma_fix(r, _mm_xor_si128(big, _mm_set1_epi32(-1)),   /* see spu__xs_fa */
+                                          spu__xs_ld(a), spu__xs_ld(b), spu__xs_ld(c), negp, negc));
