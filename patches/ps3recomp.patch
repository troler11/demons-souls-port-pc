+static void fs_aio_enqueue(uint32_t aio, uint32_t cb_opd, int32_t id, int fd,
+                           uint64_t offset, uint32_t buf, uint64_t size)
+{
+    static std::once_flag once;
+    std::call_once(once, [] { std::thread(fs_aio_worker).detach(); });
+    std::lock_guard<std::mutex> lk(s_aio_mu);
+    s_aio_q.push_back(fs_aio_req{ aio, cb_opd, id, fd, offset, buf, size });
+    s_aio_cv.notify_one();
+}
