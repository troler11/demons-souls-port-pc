+/* ld_flush_impl: a query cannot span command lists. */
+static void zp_before_close(void) { if (s_zp.active) zp_end(); }
+static void zp_after_reset(void)  { if (s_zp.enabled && s_zp.ok) zp_begin(); }
+
+/* Deliver every report whose fence the GPU has passed. */
+static void zp_poll(void)
+{
+    if (!s_zp.npend) return;
+    const u64 done = g.fence->lpVtbl->GetCompletedValue(g.fence);
+    u64* r = NULL; D3D12_RANGE rr = {0, ZP_SLOTS * 8u};
