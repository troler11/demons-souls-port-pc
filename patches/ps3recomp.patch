+    const DWORD self = GetCurrentThreadId(), pid = GetCurrentProcessId();
+    for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te)) {
+        if (te.th32OwnerProcessID != pid || te.th32ThreadID == self) continue;
+        HANDLE h = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        if (!h) continue;
+        char name[96] = "";
+        PWSTR w = NULL;
+        if (get_desc && SUCCEEDED(get_desc(h, &w)) && w) {
+            WideCharToMultiByte(CP_UTF8, 0, w, -1, name, sizeof name, NULL, NULL); LocalFree(w);
+        }
+        uintptr_t pcs[16]; int np = 0;
+        if (SuspendThread(h) != (DWORD)-1) {
+            CONTEXT c; c.ContextFlags = CONTEXT_FULL;
+            if (GetThreadContext(h, &c)) {
+                __try {
+                    for (int depth = 0; depth < 32 && np < 16 && c.Rip; depth++) {
+                        pcs[np++] = (uintptr_t)c.Rip;
+                        DWORD64 img = 0;
+                        RUNTIME_FUNCTION* rf = RtlLookupFunctionEntry(c.Rip, &img, NULL);
+                        if (!rf) { c.Rip = *(const DWORD64*)c.Rsp; c.Rsp += 8; continue; }
+                        void* hd = NULL; DWORD64 fr = 0;
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, img, c.Rip, rf, &c, &hd, &fr, NULL);
+                    }
+                } __except (EXCEPTION_EXECUTE_HANDLER) {}
+            }
+            ResumeThread(h);           /* resolve names after: lookups may take locks */
+        }
+        CloseHandle(h);
+        char line[4096]; int n = snprintf(line, sizeof line, "[hang] thread %lu '%s':", te.th32ThreadID, name);
+        for (int i = 0; i < np && n < (int)sizeof line - 200; i++) {
+            char f[200]; hang_frame_name(pcs[i], base, end, f, sizeof f);
+            n += snprintf(line + n, sizeof line - n, "%s %s", i ? " <" : "", f);
+        }
+        fprintf(stderr, "%s\n", line);
+    }
+    CloseHandle(snap);
+}
+static DWORD WINAPI hang_watch_thread(LPVOID p)
+{
+    const unsigned secs = (unsigned)(uintptr_t)p;
+    unsigned last = ppu_boot_frames_presented();
+    ULONGLONG since = GetTickCount64();
+    int dumps = 0, armed = 1;
+    for (;;) {
+        Sleep(250);
+        const unsigned f = ppu_boot_frames_presented();
+        const ULONGLONG now = GetTickCount64();
+        { static ULONGLONG beat; if (getenv("PS3_HANG_BEAT") && now - beat >= 10000) {
+              beat = now; fprintf(stderr, "[hang] beat: frame %u, unchanged for %.1f s\n", f, (now - since) / 1000.0); } }
+        /* PS3_HANG_TEST=<s>: one forced dump that many seconds after the
+         * first frame, to check the dump itself. */
+        { static ULONGLONG first; static int forced; static long test = -1;
+          if (test < 0) { const char* e = getenv("PS3_HANG_TEST"); test = e ? atol(e) : 0; }
+          if (f && !first) first = now;
+          if (test > 0 && !forced && first && now - first >= (ULONGLONG)test * 1000ull) {
+              forced = 1;
+              fprintf(stderr, "\n[hang] ==== forced dump (PS3_HANG_TEST), frame %u ====\n", f);
+              su_load_map(); hang_dump_host_threads(); evq_hang_report();
+              fprintf(stderr, "[hang] ==== end of dump ====\n"); fflush(stderr);
+          } }
+        if (f != last) {
+            if (!armed) fprintf(stderr, "[hang] frames resumed after %.1f s (frame %u)\n", (now - since) / 1000.0, f);
+            last = f; since = now; armed = 1; continue;
+        }
+        if (!f || !armed || dumps >= 3 || now - since < secs * 1000ull) continue;
+        armed = 0; dumps++;
+        fprintf(stderr, "\n[hang] ==== no guest frame for %u s (frame %u, dump %d/3) ====\n", secs, f, dumps);
+        su_load_map();
+        hang_dump_host_threads();
+        evq_hang_report();
+        fprintf(stderr, "[hang] ==== end of dump ====\n");
+        fflush(stderr);
+    }
+}
+static struct HangWatchInit {
+    HangWatchInit() {
+        const char* e = getenv("PS3_HANG_DUMP");
+        const int s = e ? atoi(e) : 0;
