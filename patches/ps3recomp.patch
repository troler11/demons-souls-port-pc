+
+static void zp_begin(void)
+{
+    if (s_zp.active) return;
+    s_zp.active_slot = (u16)(s_zp.next_slot++ % ZP_SLOTS);
+    g.list->lpVtbl->BeginQuery(g.list, s_zp.heap, D3D12_QUERY_TYPE_OCCLUSION, s_zp.active_slot);
+    s_zp.active = 1;
