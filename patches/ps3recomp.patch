+/* Exact min/max cache for already-resolved BE index spans. The pointer finds
+ * candidates; every byte, index width and restart state must match for reuse.
+ * Access is serialized by the live renderer entry lock. */
+#ifndef RSX_INDEX_RANGE_H
+#define RSX_INDEX_RANGE_H
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdio.h>
+#if defined(__AVX2__)
+#include <immintrin.h>
+#endif
+#define LD_IR_SETS 1024u
+#define LD_IR_WAYS 4u
+#define LD_IR_BUDGET (8u << 20)
+#define LD_IR_MAX_SPAN (1u << 20)
+typedef struct {
+    const uint8_t* address;
+    uint8_t* bytes;
+    uint32_t count, is32, restart, restart_value, lo, hi;
+    size_t size;
+} ld_ir_entry;
+static struct {
+    ld_ir_entry entry[LD_IR_SETS][LD_IR_WAYS];
+    uint32_t next[LD_IR_SETS];
+    size_t retained;
+    uint64_t hits, misses, plain, budget_skips;
+} s_index_range;
+
+static int ld_index_range_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_INDEX_RANGE_CACHE");
+        on = e && *e == '1'; /* experiment: the initial A/B was slower */
+        fprintf(stderr, "[index-range] %s (full-byte validation, LD_INDEX_RANGE_CACHE=0 selects original scan)\n", on ? "ON" : "OFF");
+    }
+    return on;
+}
+
+static void ld_index_range_scan_scalar(const uint8_t* p, uint32_t count, int is32,
+    int restart, uint32_t restart_value, uint32_t* lo, uint32_t* hi)
+{
+    uint32_t mn = UINT32_MAX, mx = 0;
+    if (is32) {
+        for (uint32_t k = 0; k < count; k++) {
+            uint32_t v; memcpy(&v, p + k * 4u, 4); v = __builtin_bswap32(v);
+            if (restart && v == restart_value) continue;
+            if (v < mn) mn = v;
+            if (v > mx) mx = v;
+        }
+    } else {
+        for (uint32_t k = 0; k < count; k++) {
+            const uint32_t v = (uint32_t)((p[k * 2u] << 8) | p[k * 2u + 1]);
+            if (restart && v == restart_value) continue;
+            if (v < mn) mn = v;
+            if (v > mx) mx = v;
+        }
+    }
+    *lo = mn; *hi = mx;
+}
+
+static int ld_index_range_simd_enabled(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_INDEX_RANGE_SIMD");
+#if defined(__AVX2__)
+        on = !(e && *e == '0');
+#else
+        (void)e; on = 0;
+#endif
+        fprintf(stderr, "[index-range] scan=%s (LD_INDEX_RANGE_SIMD=0 selects scalar)\n", on ? "AVX2" : "scalar");
+    }
+    return on;
+}
+
+#if defined(__AVX2__)
+static void ld_index_range_scan_avx2(const uint8_t* p, uint32_t count, int is32,
+    int restart, uint32_t rv, uint32_t* lo, uint32_t* hi)
+{
+    uint32_t k = 0, mn = UINT32_MAX, mx = 0;
+    const __m256i ones = _mm256_set1_epi32(-1);
+    __m256i vmin = ones, vmax = _mm256_setzero_si256();
+    if (is32 && count >= 8) {
+        const __m256i swap = _mm256_setr_epi8(3,2,1,0,7,6,5,4,11,10,9,8,15,14,13,12,
+            3,2,1,0,7,6,5,4,11,10,9,8,15,14,13,12);
+        const __m256i needle = _mm256_set1_epi32((int32_t)rv);
+        for (; count-k >= 8; k += 8) {
+            __m256i a = _mm256_shuffle_epi8(_mm256_loadu_si256((const __m256i*)(p + (size_t)k*4)), swap);
+            __m256i b = a;
+            if (restart) {
+                const __m256i skip = _mm256_cmpeq_epi32(a, needle);
+                a = _mm256_or_si256(a, skip); b = _mm256_andnot_si256(skip, b);
+            }
