+static const char* gcm_getenv(const char* name)
+{
+    enum { N = 128 };
+    static const char* _Atomic keys[N];
+    static const char* vals[N];
+    static atomic_long used;
+    const long n = atomic_load(&used);
+    for (long i = 0; i < n && i < N; i++)
+        if (atomic_load_explicit(&keys[i], memory_order_acquire) == name) return vals[i];
+    const char* v = getenv(name);
+    const long slot = atomic_fetch_add(&used, 1);
+    if (slot < N) { vals[slot] = v; atomic_store_explicit(&keys[slot], name, memory_order_release); }
+    return v;
+}
 
