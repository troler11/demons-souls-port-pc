+static const char* semp_thread(void)
+{
+    static __declspec(thread) char name[32];
+    if (!name[0]) {
+        typedef HRESULT (WINAPI *get_desc_fn)(HANDLE, PWSTR*);
+        static get_desc_fn gd;
+        if (!gd) gd = (get_desc_fn)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription");
+        PWSTR w = NULL;
+        if (gd && SUCCEEDED(gd(GetCurrentThread(), &w)) && w && w[0]) {
+            int i = 0; for (; w[i] && i < 31; i++) name[i] = (char)(w[i] < 128 ? w[i] : '?');
