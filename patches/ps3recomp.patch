diff --git a/runtime/spu/spu_regcache.h b/runtime/spu/spu_regcache.h
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_regcache.h
@@ -0,0 +1,67 @@
+/* Private implementation included by spu_channels.c after spu_fn is defined.
+ * Register-cached twins: adapted from whompay/inFAMOUSreborn (2e9405c, MIT).
+ * Registration runs in constructors; selection is immutable after startup.
+ * The registry memoizes the selected function so hot indirect branches do
+ * not pay a second pointer-hash lookup. SPU_REGCACHE=0 selects originals. */
+#define SPU_RC_MAX_IMAGES 256u
+static const void* const* s_rc_pairs[SPU_RC_MAX_IMAGES];
+static unsigned s_rc_counts[SPU_RC_MAX_IMAGES], s_rc_images;
+static const void** s_rc_hash;
+static uint32_t s_rc_mask;
+static INIT_ONCE s_rc_once = INIT_ONCE_STATIC_INIT;
+
+void spu_rc_add_pairs(const void* const* pairs, unsigned n)
+{
+    if (s_rc_images >= SPU_RC_MAX_IMAGES) {
+        fprintf(stderr, "[spu-regcache] too many images; no pairs registered for image %u\n", s_rc_images);
+        return;
+    }
+    s_rc_pairs[s_rc_images] = pairs; s_rc_counts[s_rc_images++] = n;
+}
+static uint32_t spu_rc_slot(const void* fn)
+{
+    uint64_t x = (uint64_t)(uintptr_t)fn;
+    x ^= x >> 29; x *= 0x9E3779B97F4A7C15ull;
+    return (uint32_t)(x >> 32);
+}
+static BOOL CALLBACK spu_rc_init(PINIT_ONCE once, PVOID parameter, PVOID* context)
+{
+    (void)once; (void)parameter; (void)context;
+    const char* e = getenv("SPU_REGCACHE");
+    int on = !e || atoi(e) != 0;
+    /* LS diagnostics may observe the context inside otherwise pure helpers. */
+    if (getenv("SPU_LS_WATCH") || getenv("SPU_LS_LOWREAD") || getenv("SPU_SMC_WATCH")) on = 0;
+    unsigned total = 0;
+    for (unsigned t = 0; t < s_rc_images; t++) total += s_rc_counts[t];
+    if (on && total) {
+        uint32_t size = 1024;
+        while (size < 2u * total) size <<= 1;
+        s_rc_hash = (const void**)calloc((size_t)size * 2u, sizeof(void*));
+        if (s_rc_hash) {
+            s_rc_mask = size - 1;
+            for (unsigned t = 0; t < s_rc_images; t++)
+                for (unsigned i = 0; i < s_rc_counts[t]; i++) {
+                    const void* key = s_rc_pairs[t][2 * i];
+                    const void* value = s_rc_pairs[t][2 * i + 1];
+                    uint32_t h = spu_rc_slot(key) & s_rc_mask;
+                    while (s_rc_hash[2 * h] && s_rc_hash[2 * h] != key) h = (h + 1) & s_rc_mask;
+                    s_rc_hash[2 * h] = key; s_rc_hash[2 * h + 1] = value;
+                }
+        }
+    }
+    fprintf(stderr, "[spu-regcache] %s: %u function pairs, %u images (SPU_REGCACHE=0 selects originals)\n",
+        s_rc_hash ? "ON" : "OFF", total, s_rc_images);
+    return TRUE;
+}
+spu_fn spu_rc_select(spu_fn fn)
+{
+    if (!fn) return fn;
+    InitOnceExecuteOnce(&s_rc_once, spu_rc_init, NULL, NULL);
+    if (!s_rc_hash) return fn;
+    uint32_t h = spu_rc_slot((const void*)fn) & s_rc_mask;
+    while (s_rc_hash[2 * h]) {
+        if (s_rc_hash[2 * h] == (const void*)fn) return (spu_fn)s_rc_hash[2 * h + 1];
+        h = (h + 1) & s_rc_mask;
+    }
+    return fn; /* already cached, or a handwritten runtime function */
+}
diff --git a/runtime/spu/spu_channel_direct.h b/runtime/spu/spu_channel_direct.h
new file mode 100644
--- /dev/null
+++ b/runtime/spu/spu_channel_direct.h
@@ -0,0 +1,43 @@
+/* Experimental small writes outside the DMA/diagnostic stack frame.
+ * Opt-in: the gameplay A/B did not establish a consistent FPS improvement.
+ * The caller disables this path whenever SPU_CHHIST is present. */
+#ifndef SPU_CHANNEL_DIRECT_H
+#define SPU_CHANNEL_DIRECT_H
+#include "spu_context.h"
+#include "../platform/win32_compat.h"
+
+static int spu_wrch_direct_enabled(void)
+{
+    static volatile long state = -1;
+#if defined(__clang__) || defined(__GNUC__)
+    long on = __atomic_load_n(&state, __ATOMIC_ACQUIRE);
+#else
+    long on = _InterlockedCompareExchange(&state, -1, -1);
+#endif
+    if (on < 0) {
+        const char* e = getenv("SPU_WRCH_DIRECT");
+        on = e && *e == '1' && !getenv("SPU_CHHIST");
+        _InterlockedCompareExchange(&state, on, -1);
+    }
+    return (int)on;
+}
+
+static int spu_wrch_direct_try(spu_context* ctx, uint32_t ch, u128 value)
+{
+    const uint32_t v = value._u32[0];
+    switch (ch) {
+    case SPU_WrEventAck:
+        _InterlockedAnd((volatile long*)&ctx->event_status, (long)~v);
+        return 1;
+    case SPU_WrEventMask: ctx->event_mask = v; return 1;
+    case SPU_WrSRR0: ctx->srr0 = v; return 1;
+    case MFC_LSA: ctx->mfc_lsa = v; return 1;
+    case MFC_EAH: ctx->mfc_eah = v; return 1;
+    case MFC_EAL: ctx->mfc_eal = v; return 1;
+    case MFC_Size: ctx->mfc_size = v; return 1;
+    case MFC_TagID: ctx->mfc_tag = v & 0x1fu; return 1;
+    case MFC_WrTagMask: ctx->mfc_tag_mask = v; return 1;
+    default: return 0; /* commands, status events, mailboxes and timers use runtime */
+    }
+}
+#endif
diff --git a/runtime/ppu/tests/test_vmx_fp_sse.c b/runtime/ppu/tests/test_vmx_fp_sse.c
new file mode 100644
--- /dev/null
+++ b/runtime/ppu/tests/test_vmx_fp_sse.c
@@ -0,0 +1,82 @@
+/* ppu_vmx.h: the SSE forms of vaddfp / vsubfp / vmaddfp / vnmsubfp must give
+ * the same bits as the element-loop references, for both VSCR[NJ] settings.
+ * Special values (zeros, denormals, infinities, NaNs with payloads, extremes)
+ * in every lane combination, then random vectors biased toward them.
+ * Build: clang-cl /O2 -mavx2 -mfma test_vmx_fp_sse.c (from this directory). */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "../ppu_vmx.h"
+
+#if !(defined(__AVX2__) && defined(__FMA__))
+#error "build with -mavx2 -mfma: this tests the SSE forms"
+#endif
+
+static const uint32_t k_special[] = {
+    0x00000000u, 0x80000000u, 0x00000001u, 0x807FFFFFu, 0x00400000u, 0x00800000u,
+    0x80800000u, 0x3F800000u, 0xBF800000u, 0x7F7FFFFFu, 0xFF7FFFFFu, 0x7F800000u,
+    0xFF800000u, 0x7FC00000u, 0xFFC00000u, 0x7F800001u, 0xFFBFFFFFu, 0x7FC12345u,
+    0x34000000u, 0xB4000000u, 0x4B000000u, 0x3EAAAAABu,
+};
+#define NSPECIAL (sizeof k_special / sizeof k_special[0])
+
+static uint64_t s_rng = 0x9E3779B97F4A7C15ull;
+static uint32_t rnd(void) { s_rng ^= s_rng << 13; s_rng ^= s_rng >> 7; s_rng ^= s_rng << 17; return (uint32_t)(s_rng >> 16); }
+static uint32_t rnd_val(void)
+{
+    const uint32_t r = rnd();
+    switch (r & 7) {
+    case 0: return k_special[(r >> 3) % NSPECIAL];
+    case 1: return (r & 0x807FFFFFu);                      /* denormal or zero */
+    case 2: return (rnd() & 0x80000000u) | 0x3F800000u | (rnd() & 0x7FFFFFu);   /* ~1.0 */
+    default: return rnd();
+    }
+}
+static void put(uint8_t* v, int i, uint32_t x) { vmx_sw(v, i, x); }
+
+static unsigned long long s_fail;
+static void check(const char* op, const uint8_t* ref, const uint8_t* got, const uint8_t* a, const uint8_t* b, const uint8_t* c, uint32_t vscr)
+{
+    if (!memcmp(ref, got, 16)) return;
+    if (s_fail++ < 10) {
+        for (int i = 0; i < 4; i++)
+            if (vmx_w(ref, i) != vmx_w(got, i))
+                printf("%s vscr=%X lane %d: a=%08X b=%08X c=%08X ref=%08X sse=%08X\n", op, vscr, i,
+                       vmx_w(a, i), vmx_w(b, i), c ? vmx_w(c, i) : 0, vmx_w(ref, i), vmx_w(got, i));
+    }
+}
+
+static void run(const uint8_t* a, const uint8_t* b, const uint8_t* c, uint32_t vscr)
+{
+    uint8_t r[16], g[16];
+    vmx_vaddfp_ref(r, a, b, vscr);    vmx_vaddfp(g, a, b, vscr);    check("vaddfp", r, g, a, b, 0, vscr);
+    vmx_vsubfp_ref(r, a, b, vscr);    vmx_vsubfp(g, a, b, vscr);    check("vsubfp", r, g, a, b, 0, vscr);
+    vmx_vmaddfp_ref(r, a, b, c, vscr); vmx_vmaddfp(g, a, b, c, vscr); check("vmaddfp", r, g, a, b, c, vscr);
+    vmx_vnmsubfp_ref(r, a, b, c, vscr); vmx_vnmsubfp(g, a, b, c, vscr); check("vnmsubfp", r, g, a, b, c, vscr);
+}
+
+int main(void)
+{
+    uint8_t a[16], b[16], c[16];
+    unsigned long long n = 0;
+    for (int nj = 0; nj < 2; nj++) {
+        const uint32_t vscr = nj ? VMX_NJ : 0;
+        /* every special triple, one per lane slot with different neighbours */
+        for (size_t i = 0; i < NSPECIAL; i++)
+            for (size_t j = 0; j < NSPECIAL; j++)
+                for (size_t k = 0; k < NSPECIAL; k++) {
+                    for (int l = 0; l < 4; l++) {
+                        put(a, l, k_special[(i + l) % NSPECIAL]);
+                        put(b, l, k_special[(j + 3 * l) % NSPECIAL]);
+                        put(c, l, k_special[(k + 5 * l) % NSPECIAL]);
+                    }
+                    run(a, b, c, vscr); n++;
+                }
+        for (int it = 0; it < 10000000; it++) {
+            for (int l = 0; l < 4; l++) { put(a, l, rnd_val()); put(b, l, rnd_val()); put(c, l, rnd_val()); }
+            run(a, b, c, vscr); n++;
+        }
+    }
+    printf("%llu vectors x 4 ops, %llu mismatches\n", n, s_fail);
+    return s_fail != 0;
+}
