+/* Frames the decoder can still run on before the title must stream more. */
+static s32 remain_frames(const AtracSlot* s)
+{
+    if (!s->streaming || s->loaded >= s->file_size) return CELL_ATRAC_ALLDATA_IS_ON_MEMORY;
+    const s32 have = (s32)((s->loaded - s->t.data_off) / s->t.block_align);
+    const s32 r = have - s->pos / AT3P_SAMPLES;
+    return r > 0 ? r : 0;
+}
+
+/* Where the title writes the next chunk of the file, how much fits and
+ * which file offset it must read from. AddStreamData copies the chunk out
+ * right away, so the whole buffer is always free. */
+static s32 atrac_impl_GetStreamDataInfo(u32 pHandle, u32 ppucWritePointer, u32 puiWritableByte,
+                               u32 puiReadPosition)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    u32 writable = 0;
+    if (s->streaming && s->loaded < s->file_size) {
+        writable = s->file_size - s->loaded;
+        if (writable > s->buf_size) writable = s->buf_size;
+    }
+    if (ppucWritePointer) vm_write32(ppucWritePointer, s->buf_ea);
+    if (puiWritableByte)  vm_write32(puiWritableByte, writable);
+    if (puiReadPosition)  vm_write32(puiReadPosition, s->loaded);
+    return CELL_OK;
+}
+
+static s32 atrac_impl_AddStreamData(u32 pHandle, u32 uiAddByte)
+{
+    AtracSlot* s = slot_of(pHandle);
+    if (!s) return (s32)CELL_ATRAC_ERROR_UNSET_DATA;
+    if (!s->streaming) return (s32)CELL_ATRAC_ERROR_ALLDATA_IS_ONMEMORY;
+    if (uiAddByte > s->buf_size || s->loaded + uiAddByte > s->file_size)
+        return (s32)CELL_ATRAC_ERROR_READSIZE_OVER_BUFFER;
+    memcpy(s->host + s->loaded, vm_base + s->buf_ea, uiAddByte);
+    s->loaded += uiAddByte;
+    return CELL_OK;
+}
