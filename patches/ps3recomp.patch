+static SPU_THREAD_LOCAL uint32_t t_llar_ea = 0xFFFFFFFFu;
+static SPU_THREAD_LOCAL unsigned t_llar_rep;
+static SPU_THREAD_LOCAL spu_context* t_mfc_ctx;
+static SPU_THREAD_LOCAL mfc_engine* t_mfc;
+static SPU_THREAD_LOCAL LONG t_mfc_gen = -1;
+static mfc_engine* mfc_for_slow(spu_context* ctx);
+static mfc_engine* mfc_for(spu_context* ctx)
+{
+    const LONG gen = s_mfc_gen;
+    if (ctx == t_mfc_ctx && gen == t_mfc_gen) return t_mfc;
+    mfc_engine* m = mfc_for_slow(ctx);
+    t_mfc_ctx = ctx; t_mfc = m; t_mfc_gen = gen;
+    return m;
