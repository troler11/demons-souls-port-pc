+
+/* Close the open query; it joins the running report sum. */
+static void zp_end(void)
+{
+    if (!s_zp.active) return;
+    g.list->lpVtbl->EndQuery(g.list, s_zp.heap, D3D12_QUERY_TYPE_OCCLUSION, s_zp.active_slot);
+    g.list->lpVtbl->ResolveQueryData(g.list, s_zp.heap, D3D12_QUERY_TYPE_OCCLUSION,
+                                     s_zp.active_slot, 1, s_zp.rb, (UINT64)s_zp.active_slot * 8u);
+    s_zp.active = 0;
+    if (s_zp.nseg < ZP_SEGS) s_zp.seg[s_zp.nseg++] = s_zp.active_slot;
