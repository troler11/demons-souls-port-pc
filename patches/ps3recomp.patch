+/* The fix-ups above for code already in the SPU float mode (MXCSR RZ+FTZ+DAZ),
+ * without leaving it. A single with biased exponent 1..255 (255 is ordinary
+ * extended range on the SPU) is exactly a double; a product of two is exact in
+ * double, and a sum truncated toward zero to 53 bits then to 24 is the sum
+ * truncated to 24 -- so both are one double op plus a hand-made truncation:
+ * saturate at or above 2^129, flush below 2^-126, never -0. Scalar SPU code
+ * leaves extended-range garbage in its unused lanes, so in Demon's Souls'
+ * _synth2 audio SPU the old fix-ups (a mode switch and the generic reference
+ * per lane) were a quarter of the thread's time. SPU_FAST_FIX=0: off. */
+SPU__XS_INLINE double spu__ext_d(uint32_t x) {
+    const uint64_t u = ((uint64_t)(x & 0x80000000u) << 32) |
+                       ((uint64_t)(((x >> 23) & 255u) + 896u) << 52) |
+                       ((uint64_t)(x & 0x7FFFFFu) << 29);
+    double d; memcpy(&d, &u, 8); return d;
+}
+SPU__XS_INLINE uint32_t spu__d_ext(double d) {
+    uint64_t u; memcpy(&u, &d, 8);
+    if (!(u << 1)) return 0;
+    const uint32_t s = (uint32_t)(u >> 32) & 0x80000000u;
+    const int e = (int)((u >> 52) & 0x7FF) - 896;
+    if (e <= 0) return 0;
+    if (e > 255) return s | 0x7FFFFFFFu;
+    return s | ((uint32_t)e << 23) | (uint32_t)((u >> 29) & 0x7FFFFFu);
+}
+SPU__XS_INLINE uint32_t spu__fa_rz(uint32_t x, uint32_t y) {
+    const int zx = !(x & 0x7F800000u), zy = !(y & 0x7F800000u);   /* zero/denormal = 0 */
+    if (zx) return zy ? 0 : y;
+    if (zy) return x;
+    return spu__d_ext(spu__ext_d(x) + spu__ext_d(y));
+}
+SPU__XS_INLINE uint32_t spu__fm_rz(uint32_t x, uint32_t y) {
+    if (!(x & 0x7F800000u) || !(y & 0x7F800000u)) return 0;
+    return spu__d_ext(spu__ext_d(x) * spu__ext_d(y));
+}
+SPU__XS_INLINE int spu__fast_fix(void) {
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("SPU_FAST_FIX"); v = !(e && e[0] == '0'); }
+    return v;
+}
+SPU__XS_SLOW __m128i spu__xs_fa_fixz(__m128i r, __m128i ok, __m128i a, __m128i b, uint32_t negb) {
+    if (!spu__fast_fix()) return spu__xs_fa_fix(r, ok, a, b, negb);
+    SPU__XS_LANES(r, o); SPU__XS_LANES(ok, m); SPU__XS_LANES(a, x); SPU__XS_LANES(b, y);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fa_rz(x[i], y[i] ^ negb);
+    return _mm_loadu_si128((const __m128i*)(const void*)o);
+}
+SPU__XS_SLOW __m128i spu__xs_fm_fixz(__m128i r, __m128i ok, __m128i a, __m128i b) {
+    if (!spu__fast_fix()) return spu__xs_fm_fix(r, ok, a, b);
+    SPU__XS_LANES(r, o); SPU__XS_LANES(ok, m); SPU__XS_LANES(a, x); SPU__XS_LANES(b, y);
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fm_rz(x[i], y[i]);
+    return _mm_loadu_si128((const __m128i*)(const void*)o);
+}
+SPU__XS_SLOW __m128i spu__xs_fma_fix(__m128i r, __m128i ok, __m128i a, __m128i b, __m128i c,
+                                     uint32_t negp, uint32_t negc) {
+    SPU__XS_LANES(r, o); SPU__XS_LANES(ok, m); SPU__XS_LANES(a, x); SPU__XS_LANES(b, y); SPU__XS_LANES(c, z);
+    SPU_FP_STD_BEGIN;
+    for (int i = 0; i < 4; i++) if (!m[i]) o[i] = spu__fma_any(x[i], y[i], z[i], negp, negc);
+    SPU_FP_STD_END;
+    return _mm_loadu_si128((const __m128i*)(const void*)o);
+}
+SPU__XS_INLINE u128 spu__xs_fa_exact(u128 a, u128 b, uint32_t negb) {
+    const __m128i xa = spu__xs_ld(a), yb = spu__xs_ld(b);
+    const __m128i x = xa, y = _mm_xor_si128(yb, _mm_set1_epi32((int)negb));
+    /* the exponent-gap limit (exact sum in double) applies only between two nonzero terms */
+    const __m128i gap = _mm_abs_epi32(_mm_sub_epi32(spu__xs_bexp(x), spu__xs_bexp(y)));
+    const __m128i pre = _mm_and_si128(_mm_and_si128(spu__xs_plain0(x), spu__xs_plain0(y)),
+                                      _mm_or_si128(_mm_cmplt_epi32(gap, _mm_set1_epi32(30)),
+                                                   _mm_or_si128(spu__xs_zero(x), spu__xs_zero(y))));
