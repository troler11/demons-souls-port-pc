+/* ---- PS3_HANG_DUMP=<seconds>: a frozen game, explained -------------------
+ * The Nexus freeze (docs/STUTTER_FOLLOWUP.md) stops presenting for seconds to
+ * minutes, intermittently, with audio and the FIFO still running; samples
+ * taken by hand afterwards could not say who waits for whom. This watches the
+ * guest flip count and, when it stands still for the given time, dumps once
+ * per stall (3 at most): every host thread's native stack, frames named from
+ * the link map (guest func_ / spu_ functions and runtime ones). Every
+ * blocked guest thread shows the syscall it waits in (sys_cond_wait,
+ * sys_event_queue_receive, ...) and the guest functions that called it. */
+extern "C" unsigned ppu_boot_frames_presented(void);
+extern "C" void evq_hang_report(void);
+extern "C" uint32_t hang_watch_line(void);
+extern "C" void hang_trace(char k, uint32_t a, uint32_t b, uint32_t c, uint32_t d);
+static void hang_frame_name(uintptr_t pc, uintptr_t base, uintptr_t end, char* out, size_t cap)
+{
+    if (pc >= base && pc < end) {
+        const SuSym* s = su_sym((uint32_t)(pc - base));
+        if (s) {
+            const char* n = s->name; const char* q = n[0] == '?' ? n + 1 : n;
+            const char* at = strstr(q, "@@");
+            const size_t len = at ? (size_t)(at - q) : strlen(q);
+            snprintf(out, cap, "%.*s+0x%X", (int)(len < 120 ? len : 120), q,
+                     (unsigned)((pc - base) - s->rva));
+            return;
+        }
+    }
+    HMODULE m = NULL; char mod[MAX_PATH] = "?";
+    if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           (LPCSTR)pc, &m) && m) {
+        GetModuleFileNameA(m, mod, sizeof mod);
+        const char* b = strrchr(mod, '\\');
+        snprintf(out, cap, "%s+0x%llX", b ? b + 1 : mod, (unsigned long long)(pc - (uintptr_t)m));
+        return;
+    }
+    snprintf(out, cap, "0x%llX", (unsigned long long)pc);
+}
+static void hang_dump_host_threads(void)
+{
+    static uintptr_t base, end;
+    if (!base) {
+        base = (uintptr_t)GetModuleHandleA(NULL);
+        const IMAGE_NT_HEADERS* nt = (const IMAGE_NT_HEADERS*)(base + ((const IMAGE_DOS_HEADER*)base)->e_lfanew);
+        end = base + nt->OptionalHeader.SizeOfImage;
+    }
+    typedef HRESULT (WINAPI *desc_fn)(HANDLE, PWSTR*);
+    static desc_fn get_desc = (desc_fn)GetProcAddress(GetModuleHandleA("kernel32.dll"), "GetThreadDescription");
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snap == INVALID_HANDLE_VALUE) return;
