+static semp_row s_semp[SYS_SEMAPHORE_MAX];
+static SRWLOCK s_semp_lock = SRWLOCK_INIT;
+static LARGE_INTEGER s_semp_freq, s_semp_next;
+static int semp_on(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("SEM_PROF"); on = e && *e == '1'; QueryPerformanceFrequency(&s_semp_freq); }
+    return on;
