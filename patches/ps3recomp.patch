+/* ---------------------------------------------------------------------------
+ * One renderer, two threads. The FIFO walker drives everything above; a host
+ * movie (sail_host_movie.c) presents its frames from its own thread, through
+ * the same command list, upload ring and swap chain. Unserialized, the two
+ * corrupted the list (Close E_FAIL) or the device (Present DEVICE_REMOVED)
+ * during Demon's Souls' opening movie, and the screen stayed black after it.
+ * Every entry point takes this one recursive lock; uncontended it costs a few
+ * tens of nanoseconds.
+ * -----------------------------------------------------------------------*/
+static CRITICAL_SECTION s_ld_entry_lock;
+static INIT_ONCE s_ld_entry_once = INIT_ONCE_STATIC_INIT;
+static BOOL CALLBACK ld_entry_init(PINIT_ONCE o, PVOID p, PVOID* c)
+{ (void)o; (void)p; (void)c; InitializeCriticalSection(&s_ld_entry_lock); return TRUE; }
+static void ld_lock(void)
+{ InitOnceExecuteOnce(&s_ld_entry_once, ld_entry_init, NULL, NULL); EnterCriticalSection(&s_ld_entry_lock); }
+static void ld_unlock(void) { LeaveCriticalSection(&s_ld_entry_lock); }
+
+void rsx_live_draw_method(u32 method, u32 arg)
