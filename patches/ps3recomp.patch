+    ID3D12Resource* bb = g.backbuf[bbi];
+    fg_barrier(bb, D3D12_RESOURCE_STATE_PRESENT, D3D12_RESOURCE_STATE_COPY_DEST);
+    fg_barrier(s_fg.hist[s_fg.cur], FG_SR, D3D12_RESOURCE_STATE_COPY_SOURCE);
+    g.list->lpVtbl->CopyResource(g.list, bb, s_fg.hist[s_fg.cur]);
