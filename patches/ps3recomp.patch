+struct fs_aio_req { uint32_t aio, cb_opd; int32_t id; int fd; uint64_t offset; uint32_t buf; uint64_t size; };
+static std::mutex              s_aio_mu;
+static std::condition_variable s_aio_cv;
+static std::deque<fs_aio_req>  s_aio_q;
+
+static void fs_aio_worker()
+{
+    for (;;) {
+        fs_aio_req r;
+        {
+            std::unique_lock<std::mutex> lk(s_aio_mu);
+            s_aio_cv.wait(lk, [] { return !s_aio_q.empty(); });
+            r = s_aio_q.front();
+            s_aio_q.pop_front();
+        }
+        size_t n = 0;
+        int32_t err = fs_aio_do_read(r.fd, r.offset, r.buf, r.size, &n);
+        if (getenv("PS3_FSLOG"))
+            fprintf(stderr, "[fs] aio read (async) id=%d fd=%d off=%llu size=%llu -> %zu\n",
+                    r.id, r.fd, (unsigned long long)r.offset, (unsigned long long)r.size, n);
+        if (r.cb_opd) ps3_invoke_guest(r.cb_opd, r.aio, (uint64_t)(int64_t)err,
+                                       (uint64_t)(int64_t)r.id, (uint64_t)n, 0, 0, 0, 0);
+    }
+}
