+        gcm_zpass_deliver(p->off, p->main_mem, sum > 0xFFFFFFFFull ? 0xFFFFFFFFu : (u32)sum);
+        { static int n; if (n++ < 8) fprintf(stderr, "[zpass] report 0x%X = %llu (%u segments)\n",
