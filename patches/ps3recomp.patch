+/* PS3_SAMPLE_CHAIN=1 (with PS3_SAMPLE_MAIN): every 200th sample, print the lifted
+ * functions found on the host stack, innermost first. Lifted calls are host calls,
+ * so this is the guest call chain -- what a busy loop's caller is, when the loop body
+ * is a generic wait helper. Stale stack slots can add noise; repeated chains do not. */
+static char s_chain_line[1024];
+static int  s_chain_ready;
+static void samp_print_chain(const CONTEXT* c)
+{
+    const uintptr_t* sp = (const uintptr_t*)c->Rsp;
+    /* Stay inside the committed stack region: past its end is unmapped. */
+    MEMORY_BASIC_INFORMATION mbi;
+    if (!VirtualQuery(sp, &mbi, sizeof mbi) || mbi.State != MEM_COMMIT) return;
+    size_t avail = ((uintptr_t)mbi.BaseAddress + mbi.RegionSize - (uintptr_t)sp) / sizeof *sp;
+    if (avail > 16384) avail = 16384;                     /* 128 KB of stack */
+    char* line = s_chain_line; int p = snprintf(line, sizeof s_chain_line, "[samp] chain:");
+    uint32_t last = 0; int n = 0;
+    for (size_t i = 0; i < avail && n < 24; i++) {
+        uintptr_t v = sp[i];
+        uint32_t g = samp_lookup(v);
+        if (g && g != last) {
+            p += snprintf(line + p, sizeof s_chain_line - p, " %08X", g & 0x7FFFFFFFu);
+            last = g; n++;
+        }
+    }
+    s_chain_ready = 1;   /* printed by the caller after ResumeThread: the sampled
+                          * thread may hold the CRT stream lock while suspended */
+}
