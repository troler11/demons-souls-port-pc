+static void ld_surfaces_writeback(void)
+{
+    static int on = -1; static u32 maxtex;
+    if (on < 0) { on = getenv("LD_SURF_WRITEBACK") ? 1 : 0;
+                  const char* e = getenv("LD_SURF_WRITEBACK_MAX"); maxtex = e ? (u32)atoi(e) : 4096u; }
+    if (!on) return;
+    /* Default: record every copy, flush once, write them all back this
+     * frame. LD_SURF_WRITEBACK_ASYNC=1 defers the write to a later frame
+     * with no flush at all -- but by then the game may have reused that
+     * memory (a map load reallocates), and the stale texels landed on its
+     * new data: two hangs on entering the tutorial pointed there. */
+    static int async = -1;
+    if (async < 0) { const char* e = getenv("LD_SURF_WRITEBACK_ASYNC"); async = e && *e == '1'; }
+    /* Default: the copies ride the present's own flush (which already waits
+     * for the GPU) and ld_surfaces_writeback_finish() writes them back right
+     * after it -- same frame, no flush of their own. LD_SURF_WRITEBACK_FLUSH=1:
+     * a separate flush here, as before (one more CPU/GPU sync a frame). */
+    static int own_flush = -1;
+    if (own_flush < 0) { const char* e = getenv("LD_SURF_WRITEBACK_FLUSH"); own_flush = e && *e == '1'; }
+    if (async || !own_flush)
+        for (u32 i = 0; i < g.n_surfaces; i++)      /* copies whose fence passed */
+            if (g.surfaces[i].wb_pending) ld_surface_writeback_phase(&g.surfaces[i], 1);
+    int recorded = 0;
+    for (u32 i = 0; i < g.n_surfaces; i++) {
+        surface_t* s = &g.surfaces[i];
+        if (s->w * s->h > maxtex || s->last_draw_generation == s->wb_frame) continue;
+        if (s->wb_pending) continue;                /* previous copy still in flight */
+        s->wb_frame = s->last_draw_generation;
+        ld_surface_writeback_phase(s, 0);
+        recorded |= s->wb_pending;
+        { static u32 n; if (n++ < 24)
+            fprintf(stderr, "[surf-wb] %u:0x%08X %ux%u fmt=%d pitch=%u\n",
+                    s->location, s->offset, s->w, s->h, (int)s->fmt, s->pitch); }
+    }
+    if (!async && own_flush && recorded) {
+        ld_flush(LD_FLUSH_READBACK);
+        for (u32 i = 0; i < g.n_surfaces; i++)
+            if (g.surfaces[i].wb_pending) ld_surface_writeback_phase(&g.surfaces[i], 1);
+    }
+}
+
+/* After the present's flush: every copy recorded this frame is complete. */
+static void ld_surfaces_writeback_finish(void)
+{
+    for (u32 i = 0; i < g.n_surfaces; i++)
+        if (g.surfaces[i].wb_pending) ld_surface_writeback_phase(&g.surfaces[i], 1);
+}
