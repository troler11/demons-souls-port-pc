+#ifndef LD_PW_CREATE
+#define LD_PW_CREATE(device, desc, output) (device)->lpVtbl->CreateGraphicsPipelineState(device, desc, LD_CACHE_IID(IID_ID3D12PipelineState), (void**)(output))
+#endif
+static DWORD WINAPI ld_pw_worker(void* unused)
+{
