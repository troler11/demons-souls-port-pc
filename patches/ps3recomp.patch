+/* ---------------------------------------------------------------------------
+ * LD_ASYNC_PSO (default on; 0 = off): a pipeline that is neither warm nor in
+ * the pipeline library is created on a worker. CreateGraphicsPipelineState
+ * then compiles the shaders for the GPU inside the driver, and on a cold
+ * driver cache that held the render thread for whole seconds (a 7.8 s pause
+ * with frame_clock inside D3DSCache.dll, map sweep 27/10/2026). The render
+ * thread still waits for the worker up to LD_ASYNC_PSO_WAIT_MS per pipeline
+ * (default 4) and LD_ASYNC_PSO_FRAME_MS per frame (default 8), so the usual
+ * fast creation draws on time; past that the draw is skipped until the
+ * pipeline is ready (the object appears a frame or two late), the same
+ * trade as LD_ASYNC_SHADERS.
+ * -----------------------------------------------------------------------*/
+typedef struct ld_apso_job {
+    struct ld_apso_job* next;
+    volatile LONG state;            /* 0 queued, 1 creating, 2 finished */
+    u64 key;
+    HANDLE done;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC pd;
+    D3D12_INPUT_ELEMENT_DESC il[16];
+    ID3DBlob *vs, *ps;              /* hold the bytecode pd points into */
+    ID3D12PipelineState* pso;
+    HRESULT hr;
+    double ms;
+} ld_apso_job;
+#define LD_APSO_PENDING 256u
+static struct {
+    SRWLOCK lock;
+    CONDITION_VARIABLE cv;
+    ld_apso_job* head;
+    ld_apso_job* tail;
+    ld_apso_job* pending[LD_APSO_PENDING];   /* render thread only */
+    u32 n_pending;
+    int started;
+    double wait_ms, frame_ms, frame_spent;
+    u32 frame;
+    volatile LONG created, late;
+} s_apso;
+
+static DWORD WINAPI ld_apso_worker(LPVOID arg)
+{
+    (void)arg;
+    for (;;) {
+        AcquireSRWLockExclusive(&s_apso.lock);
+        while (!s_apso.head)
+            SleepConditionVariableSRW(&s_apso.cv, &s_apso.lock, INFINITE, 0);
+        ld_apso_job* job = s_apso.head;
+        s_apso.head = job->next;
+        if (!s_apso.head) s_apso.tail = NULL;
+        ReleaseSRWLockExclusive(&s_apso.lock);
+        InterlockedExchange(&job->state, 1);
+        const double begin = ld_prof_ms();
+        job->hr = ld_plib_build(g.dev, &job->pd, &job->pso);
+        job->ms = ld_prof_ms() - begin;
+        InterlockedIncrement(&s_apso.created);
+        InterlockedExchange(&job->state, 2);
+        SetEvent(job->done);
+    }
+}
+
+static int ld_async_pso_on(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("LD_ASYNC_PSO");
+        v = !(e && *e == '0');
+        const char* w = getenv("LD_ASYNC_PSO_WAIT_MS");
+        const char* f = getenv("LD_ASYNC_PSO_FRAME_MS");
+        s_apso.wait_ms = w && *w ? atof(w) : 4.0;
+        s_apso.frame_ms = f && *f ? atof(f) : 8.0;
+        if (v) {
+            InitializeSRWLock(&s_apso.lock);
+            InitializeConditionVariable(&s_apso.cv);
+            for (int i = 0; i < 2; i++) {
+                HANDLE t = CreateThread(NULL, 0, ld_apso_worker, NULL, 0, NULL);
+                if (t) { CloseHandle(t); s_apso.started++; }
+            }
+            if (!s_apso.started) v = 0;
+            fprintf(stderr, "[async-pso] %s, %d threads, wait %.1f ms per pipeline, %.1f ms per frame\n",
+                    v ? "on" : "off", s_apso.started, s_apso.wait_ms, s_apso.frame_ms);
+        }
+    }
+    return v;
+}
+
+/* Queue the creation of pd (copied, with its bytecode held). NULL: create it
+ * here -- the pending table is full or there is no event. */
+static ld_apso_job* ld_apso_start(u64 key, const D3D12_GRAPHICS_PIPELINE_STATE_DESC* pd,
+                                  ID3DBlob* vs, ID3DBlob* ps)
+{
+    if (s_apso.n_pending >= LD_APSO_PENDING || pd->InputLayout.NumElements > 16u) return NULL;
+    ld_apso_job* j = (ld_apso_job*)calloc(1, sizeof *j);
+    if (!j) return NULL;
+    j->done = CreateEventA(NULL, TRUE, FALSE, NULL);
+    if (!j->done) { free(j); return NULL; }
+    j->key = key;
+    j->pd = *pd;
+    if (pd->InputLayout.NumElements) {
+        memcpy(j->il, pd->InputLayout.pInputElementDescs, pd->InputLayout.NumElements * sizeof j->il[0]);
+        j->pd.InputLayout.pInputElementDescs = j->il;
+    }
+    vs->lpVtbl->AddRef(vs); ps->lpVtbl->AddRef(ps);
+    j->vs = vs; j->ps = ps;
+    s_apso.pending[s_apso.n_pending++] = j;
+    AcquireSRWLockExclusive(&s_apso.lock);
+    if (s_apso.tail) s_apso.tail->next = j; else s_apso.head = j;
+    s_apso.tail = j;
+    ReleaseSRWLockExclusive(&s_apso.lock);
+    WakeConditionVariable(&s_apso.cv);
+    return j;
+}
+
+/* Wait for the job within this pipeline's and this frame's budget. 1: done. */
+static int ld_apso_wait(ld_apso_job* j)
+{
+    if (j->state == 2) return 1;
+    if (s_apso.frame != g_ld_frames) { s_apso.frame = g_ld_frames; s_apso.frame_spent = 0; }
+    double budget = s_apso.frame_ms - s_apso.frame_spent;
+    if (budget > s_apso.wait_ms) budget = s_apso.wait_ms;
+    if (budget >= 1.0) {
+        const double begin = ld_prof_ms();
+        WaitForSingleObject(j->done, (DWORD)budget);
+        s_apso.frame_spent += ld_prof_ms() - begin;
+    }
+    return j->state == 2;
+}
+
+/* Take a finished job off the pending list: its pipeline (or NULL on failure). */
+static ID3D12PipelineState* ld_apso_finish(ld_apso_job* j, HRESULT* hr)
+{
+    for (u32 i = 0; i < s_apso.n_pending; i++)
+        if (s_apso.pending[i] == j) { s_apso.pending[i] = s_apso.pending[--s_apso.n_pending]; break; }
+    ID3D12PipelineState* pso = j->pso;
+    *hr = j->hr;
+    if (SUCCEEDED(j->hr) && pso) ld_pw_remember(&j->pd, pso);
+    { static int said = 0;
+      if (j->ms >= 50.0 && said++ < 16)
+          fprintf(stderr, "[async-pso] created in %.1f ms off the render thread (%ld created, %ld skipped a frame)\n",
+                  j->ms, (long)s_apso.created, (long)s_apso.late); }
+    j->vs->lpVtbl->Release(j->vs); j->ps->lpVtbl->Release(j->ps);
+    CloseHandle(j->done);
+    free(j);
+    return pso;
+}
+
+/* get_pso: 0 = no job for this key, 1 = still creating, 2 = finished (*pso,
+ * NULL if creation failed). */
+static int ld_apso_poll(u64 key, ID3D12PipelineState** pso, HRESULT* hr)
+{
+    for (u32 i = 0; i < s_apso.n_pending; i++) {
+        ld_apso_job* j = s_apso.pending[i];
+        if (j->key != key) continue;
+        if (j->state != 2) return 1;
+        *pso = ld_apso_finish(j, hr);
+        return 2;
+    }
+    return 0;
+}
