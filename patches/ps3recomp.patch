+static void ld_pw_report(void)
+{
+    if (!s_pw.device) return;
+    AcquireSRWLockShared(&s_pw.lock);
+    const LONG64 created = s_pw.created, failed = s_pw.failed, adopted = s_pw.adopted, dropped = s_pw.dropped, duplicates = s_pw.duplicates;
+    ReleaseSRWLockShared(&s_pw.lock);
