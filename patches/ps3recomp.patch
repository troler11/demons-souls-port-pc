+static mfc_engine* mfc_for_slow(spu_context* ctx)
+{
+    { static volatile LONG n; static int on = -1;          /* SPU_MFC_LISTLOG=1 */
+      if (on < 0) on = getenv("SPU_MFC_LISTLOG") ? 1 : 0;
