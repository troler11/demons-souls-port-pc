+/* ---------------------------------------------------------------------------
+ * Sony pads over HID: DualShock 4 (USB and Bluetooth) and DualSense, read
+ * directly -- no DS4Windows/Steam needed. Windows exposes them as plain HID
+ * devices, not XInput. One reader thread per pad keeps the last report; the
+ * poll just copies it. Hot-plug: rescanned every 2 s. PAD_NO_HID=1: off.
+ * Pads found here take the host ports XInput left empty.
+ * -----------------------------------------------------------------------*/
+#include <setupapi.h>
+#include <hidsdi.h>
+#pragma comment(lib, "setupapi.lib")
+#pragma comment(lib, "hid.lib")
+
+#define DS_MAX 4
+typedef struct {
+    volatile LONG live;           /* reader running */
+    HANDLE h;
+    char path[512];
+    int dualsense;
+    CRITICAL_SECTION cs;
+    PadHostState st;              /* latest state, under cs */
+} DsPad;
+static DsPad s_ds[DS_MAX];
+static volatile LONG s_ds_started;
+
+static u8 ds_axis(u8 v)           /* small deadzone around the centre */
+{
+    return (v > 120 && v < 136) ? 128 : v;
+}
+
+/* Parse one input report into a host state. Returns 0 if not a full report. */
+static int ds_parse(const u8* r, DWORD n, int dualsense, PadHostState* o)
+{
+    const u8* d; u8 hat, b0, b1, b2, l2, r2;
+    if (!dualsense) {
+        if (r[0] == 0x01 && n >= 10) d = r + 1;           /* USB */
+        else if (r[0] == 0x11 && n >= 12) d = r + 3;      /* Bluetooth, full report */
+        else return 0;
+        hat = d[4] & 15; b0 = d[4]; b1 = d[5]; b2 = d[6]; l2 = d[7]; r2 = d[8];
+    } else {
+        if (r[0] == 0x01 && n >= 11) d = r + 1;           /* USB */
+        else if (r[0] == 0x31 && n >= 12) d = r + 2;      /* Bluetooth */
+        else return 0;
+        l2 = d[4]; r2 = d[5];
+        hat = d[7] & 15; b0 = d[7]; b1 = d[8]; b2 = d[9];
+    }
+    u16 btns = 0;
+    static const u16 hatmap[8] = {
+        CELL_PAD_CTRL_UP, CELL_PAD_CTRL_UP | CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_RIGHT,
+        CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_DOWN,
+        CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_LEFT,
+        CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT };
+    if (hat < 8) btns |= hatmap[hat];
+    if (b0 & 0x10) btns |= CELL_PAD_CTRL_SQUARE;
+    if (b0 & 0x20) btns |= CELL_PAD_CTRL_CROSS;
+    if (b0 & 0x40) btns |= CELL_PAD_CTRL_CIRCLE;
+    if (b0 & 0x80) btns |= CELL_PAD_CTRL_TRIANGLE;
+    if (b1 & 0x01) btns |= CELL_PAD_CTRL_L1;
+    if (b1 & 0x02) btns |= CELL_PAD_CTRL_R1;
+    if (b1 & 0x04) btns |= CELL_PAD_CTRL_L2;
+    if (b1 & 0x08) btns |= CELL_PAD_CTRL_R2;
+    if (b1 & 0x10) btns |= CELL_PAD_CTRL_SELECT;           /* Share / Create */
+    if (b1 & 0x20) btns |= CELL_PAD_CTRL_START;            /* Options */
+    if (b1 & 0x40) btns |= CELL_PAD_CTRL_L3;
+    if (b1 & 0x80) btns |= CELL_PAD_CTRL_R3;
+    if (b2 & 0x02) btns |= CELL_PAD_CTRL_SELECT;           /* touchpad click */
+    o->connected = 1;
+    o->buttons = btns;
+    o->analog_lx = ds_axis(d[0]); o->analog_ly = ds_axis(d[1]);  /* up = 0, as on PS3 */
+    o->analog_rx = ds_axis(d[2]); o->analog_ry = ds_axis(d[3]);
+    o->trigger_l2 = l2; o->trigger_r2 = r2;
+    o->press_up       = (btns & CELL_PAD_CTRL_UP)       ? 255 : 0;
+    o->press_down     = (btns & CELL_PAD_CTRL_DOWN)     ? 255 : 0;
+    o->press_left     = (btns & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+    o->press_right    = (btns & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+    o->press_triangle = (btns & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+    o->press_circle   = (btns & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+    o->press_cross    = (btns & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+    o->press_square   = (btns & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+    o->press_l1       = (btns & CELL_PAD_CTRL_L1)       ? 255 : 0;
+    o->press_r1       = (btns & CELL_PAD_CTRL_R1)       ? 255 : 0;
+    return 1;
+}
+
+static DWORD WINAPI ds_reader(LPVOID arg)
+{
+    DsPad* p = (DsPad*)arg;
+    /* Over Bluetooth a DualShock 4 sends a reduced report until a feature
+     * report is read (0x02 calibration), a DualSense until 0x05. */
+    { u8 f[80] = {0}; f[0] = p->dualsense ? 0x05 : 0x02; HidD_GetFeature(p->h, f, sizeof f); }
+    u8 buf[128];
+    OVERLAPPED ov = {0}; ov.hEvent = CreateEventA(NULL, TRUE, FALSE, NULL);
+    for (;;) {
+        DWORD n = 0;
+        ResetEvent(ov.hEvent);
+        if (!ReadFile(p->h, buf, sizeof buf, &n, &ov)) {
+            if (GetLastError() != ERROR_IO_PENDING) break;
+            if (WaitForSingleObject(ov.hEvent, 1000) != WAIT_OBJECT_0) {
+                CancelIo(p->h);
+                continue;                        /* idle pad: keep the last state */
+            }
+            if (!GetOverlappedResult(p->h, &ov, &n, FALSE)) break;
+        }
+        PadHostState s = {0};
+        if (ds_parse(buf, n, p->dualsense, &s)) {
+            EnterCriticalSection(&p->cs); p->st = s; LeaveCriticalSection(&p->cs);
+        }
+    }
+    CloseHandle(ov.hEvent);
+    CloseHandle(p->h); p->h = NULL;
+    EnterCriticalSection(&p->cs); memset(&p->st, 0, sizeof p->st); LeaveCriticalSection(&p->cs);
+    printf("[cellPad] Sony pad disconnected\n"); fflush(stdout);
+    InterlockedExchange(&p->live, 0);
+    return 0;
+}
+
+static void ds_scan(void)
+{
+    GUID hid; HidD_GetHidGuid(&hid);
+    HDEVINFO set = SetupDiGetClassDevsA(&hid, NULL, NULL, DIGCF_PRESENT | DIGCF_DEVICEINTERFACE);
+    if (set == INVALID_HANDLE_VALUE) return;
+    SP_DEVICE_INTERFACE_DATA ifd; ifd.cbSize = sizeof ifd;
+    for (DWORD i = 0; SetupDiEnumDeviceInterfaces(set, NULL, &hid, i, &ifd); i++) {
+        union { SP_DEVICE_INTERFACE_DETAIL_DATA_A d; char raw[600]; } det;
+        det.d.cbSize = sizeof det.d;
+        if (!SetupDiGetDeviceInterfaceDetailA(set, &ifd, &det.d, sizeof det, NULL, NULL)) continue;
+        int known = 0;
+        for (int k = 0; k < DS_MAX; k++)
+            if (s_ds[k].live && !_stricmp(s_ds[k].path, det.d.DevicePath)) known = 1;
+        if (known) continue;
+        HANDLE h = CreateFileA(det.d.DevicePath, GENERIC_READ | GENERIC_WRITE,
+                               FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+                               FILE_FLAG_OVERLAPPED, NULL);
+        if (h == INVALID_HANDLE_VALUE) continue;
+        HIDD_ATTRIBUTES a; a.Size = sizeof a;
+        int ds4 = 0, dsense = 0;
+        if (HidD_GetAttributes(h, &a) && a.VendorID == 0x054C) {
+            ds4 = a.ProductID == 0x05C4 || a.ProductID == 0x09CC || a.ProductID == 0x0BA0;
+            dsense = a.ProductID == 0x0CE6 || a.ProductID == 0x0DF2;
+        }
+        int slot = -1;
+        for (int k = 0; k < DS_MAX && (ds4 || dsense); k++) if (!s_ds[k].live) { slot = k; break; }
+        if (slot < 0) { CloseHandle(h); continue; }
+        DsPad* p = &s_ds[slot];
+        p->h = h; p->dualsense = dsense;
+        strncpy(p->path, det.d.DevicePath, sizeof p->path - 1);
+        InterlockedExchange(&p->live, 1);
+        HANDLE t = CreateThread(NULL, 0, ds_reader, p, 0, NULL);
+        if (t) CloseHandle(t); else { InterlockedExchange(&p->live, 0); CloseHandle(h); continue; }
+        printf("[cellPad] %s connected (pid %04X)\n", dsense ? "DualSense" : "DualShock 4", a.ProductID);
+        fflush(stdout);
+    }
+    SetupDiDestroyDeviceInfoList(set);
+}
+
+static DWORD WINAPI ds_scanner(LPVOID arg)
+{
+    (void)arg;
+    for (;;) { ds_scan(); Sleep(2000); }
+}
+
+static void ds_start(void)
+{
+    if (InterlockedExchange(&s_ds_started, 1)) return;
+    if (getenv("PAD_NO_HID")) return;
+    for (int k = 0; k < DS_MAX; k++) InitializeCriticalSection(&s_ds[k].cs);
+    HANDLE t = CreateThread(NULL, 0, ds_scanner, NULL, 0, NULL);
+    if (t) CloseHandle(t);
+}
+
+/* Fill host ports XInput left empty with the Sony pads, in slot order. */
+static void pad_poll_hid(void)
+{
+    if (!s_ds_started) return;
+    int port = 0;
+    for (int k = 0; k < DS_MAX; k++) {
+        if (!s_ds[k].live) continue;
+        PadHostState s;
+        EnterCriticalSection(&s_ds[k].cs); s = s_ds[k].st; LeaveCriticalSection(&s_ds[k].cs);
+        if (!s.connected) continue;
+        while (port < PAD_MAX_HOST_PORTS && s_host_state[port].connected) port++;
+        if (port >= PAD_MAX_HOST_PORTS) break;
+        s_host_state[port++] = s;
+    }
+}
